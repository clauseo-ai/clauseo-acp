# Code owners for clauseo-ai/clauseo-acp.
#
# The paths below have an owner. Everything else has none: one approval from anyone other than the
# author is enough. GitHub never counts an author's own approval.

# A change to a core crate also needs the code owner's approval.
# The egress proxy lives in crates/sandbox, so that line covers it.
/crates/protocol/     @ro-hansolo
/crates/reducer/      @ro-hansolo
/crates/store/        @ro-hansolo
/crates/matters/      @ro-hansolo
/crates/host/         @ro-hansolo
/crates/acp/          @ro-hansolo
/crates/sandbox/      @ro-hansolo

# The agreement text, entity coverage and CI must be approved by the company.
/CLA.md               @ro-hansolo
/cla/entities/        @ro-hansolo
/.github/             @ro-hansolo

# Policy: the files that set lints, compiler flags, dependencies, bans, budgets, hooks, the
# toolchain, formatting and webview permissions, and xtask, whose checks are that policy in
# code. A change here needs the code owner's approval even when another reviewer has approved
# the pull request. A name without a leading slash matches in every folder, because the tool also
# reads a copy outside the root. A * in a file name covers the other names the tool reads for it.
/xtask/                              @ro-hansolo
/Cargo.toml                          @ro-hansolo
/crates/*/Cargo.toml                 @ro-hansolo
clippy.toml                          @ro-hansolo
.clippy.toml                         @ro-hansolo
/deny.toml                           @ro-hansolo
/budgets.toml                        @ro-hansolo
/lefthook.yml                        @ro-hansolo
/.config/                            @ro-hansolo
/.cargo/                             @ro-hansolo
rust-toolchain*                      @ro-hansolo
rustfmt.toml                         @ro-hansolo
.rustfmt.toml                        @ro-hansolo
/taplo.toml                          @ro-hansolo
*typos.toml                          @ro-hansolo
/.gitleaks.toml                      @ro-hansolo
/ui/pnpm-workspace.yaml              @ro-hansolo
/ui/**/package.json                  @ro-hansolo
/ui/app/tsconfig.json                @ro-hansolo
.oxlintrc.json                       @ro-hansolo
/ui/.oxfmtrc.json                    @ro-hansolo
/crates/desktop/capabilities/        @ro-hansolo
/crates/desktop/tauri.conf.json      @ro-hansolo
