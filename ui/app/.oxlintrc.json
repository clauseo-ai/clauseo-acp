{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/only-export-components": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^@tauri-apps/",
            "message": "Tauri APIs are imported only under src/transport/; everything else talks to the host through HostTransport."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/transport/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/**"]
}
