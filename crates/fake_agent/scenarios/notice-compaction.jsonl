{"update":{"update":{"sessionUpdate":"compaction_update","compactionId":"c-1","status":"in_progress"}}}
{"update":{"update":{"sessionUpdate":"compaction_summary_chunk","compactionId":"c-1","content":{"type":"text","text":"The lease was reviewed in March. "}}}}
{"update":{"update":{"sessionUpdate":"compaction_summary_chunk","compactionId":"c-1","content":{"type":"text","text":"Clause 4 caps the liability."}}}}
{"update":{"update":{"sessionUpdate":"compaction_update","compactionId":"c-1","status":"completed"}}}
{"update":{"update":{"sessionUpdate":"agent_message_chunk","messageId":"m-answer-1","content":{"type":"text","text":"The earlier turns are summarised."}}}}
{"respond":{"to":"p1","result":{"stopReason":"end_turn"}}}
