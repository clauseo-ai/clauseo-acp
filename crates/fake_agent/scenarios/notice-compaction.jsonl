{"scenario":"notice-compaction","description":"A notice, then a compaction: start, two summary chunks, end","on_stdin_close":"exit"}
{"include":"handshake.jsonl"}
{"expect":{"method":"session/prompt","as":"p1","params":{"sessionId":"sess-1"}}}
