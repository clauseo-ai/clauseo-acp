{"scenario":"rename-then-wait","description":"One turn that moves notes/p.txt to notes/q.txt beside a completed move tool_call naming both, then asks perm-1 (allow once only) and ends its turn once the client answers it: a turn that has renamed a paper and still runs","on_stdin_close":"exit"}
{"include":"handshake.jsonl"}
{"expect":{"method":"session/prompt","as":"p1","params":{"sessionId":"sess-1"}}}
{"move_file":{"from":"notes/p.txt","to":"notes/q.txt"}}
{"update":{"update":{"sessionUpdate":"tool_call","toolCallId":"t1-move","title":"Move notes/p.txt to notes/q.txt","name":"Move","kind":"move","status":"completed","locations":[{"path":"{{cwd}}/notes/p.txt"},{"path":"{{cwd}}/notes/q.txt"}]}}}
{"request":{"id":"perm-1","method":"session/request_permission","params":{"sessionId":"sess-1","toolCall":{"toolCallId":"tc-perm-1","title":"Edit clause 1","kind":"edit","status":"pending"},"options":[{"optionId":"allow-once","name":"Allow once","kind":"allow_once"}]}}}
{"expect_response":{"id":"perm-1","result":{"outcome":{"outcome":"selected","optionId":"allow-once"}}}}
{"update":{"update":{"sessionUpdate":"agent_message_chunk","messageId":"m-answer-1","content":{"type":"text","text":"Moved the note."}}}}
{"respond":{"to":"p1","result":{"stopReason":"end_turn"}}}
