{"scenario":"delete-then-wait","description":"One turn that deletes notes/p.txt (which the test made) beside a completed delete tool_call naming it, then asks perm-1 (allow once only) and ends its turn once the client answers it","on_stdin_close":"exit"}
{"include":"handshake.jsonl"}
{"expect":{"method":"session/prompt","as":"p1","params":{"sessionId":"sess-1"}}}
{"delete_file":{"path":"notes/p.txt"}}
{"update":{"update":{"sessionUpdate":"tool_call","toolCallId":"t1-delete-p","title":"Delete notes/p.txt","name":"Delete","kind":"delete","status":"completed","locations":[{"path":"{{cwd}}/notes/p.txt"}]}}}
{"request":{"id":"perm-1","method":"session/request_permission","params":{"sessionId":"sess-1","toolCall":{"toolCallId":"tc-perm-1","title":"Edit clause 1","kind":"edit","status":"pending"},"options":[{"optionId":"allow-once","name":"Allow once","kind":"allow_once"}]}}}
{"expect_response":{"id":"perm-1","result":{"outcome":{"outcome":"selected","optionId":"allow-once"}}}}
{"update":{"update":{"sessionUpdate":"agent_message_chunk","messageId":"m-answer-1","content":{"type":"text","text":"Deleted the note."}}}}
{"respond":{"to":"p1","result":{"stopReason":"end_turn"}}}
