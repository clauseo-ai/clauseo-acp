{"scenario":"steer-prompt-required","description":"claude-agent-acp steering after the turn ended: prompt 1 ends first, the steer is answered promptRequired/noRunningTurn, and the client sends the steer as prompt 2","on_stdin_close":"exit"}
{"expect":{"method":"initialize","as":"init","params":{"protocolVersion":1}}}
{"respond":{"to":"init","result":{"protocolVersion":1,"agentCapabilities":{"loadSession":true,"_meta":{"claudeCode":{"promptQueueing":true}}},"authMethods":[],"agentInfo":{"name":"fake_agent","version":"0.0.0"},"_meta":{"steering":{"supported":true}}}}}
