{"note":"No locations yet: the diff names the file.","request":{"id":"perm-codex-diff","method":"session/request_permission","params":{"sessionId":"sess-1","toolCall":{"toolCallId":"call_patch_1","title":"Edit sub/Brief.docx","kind":"edit","status":"pending","locations":[],"content":[{"type":"diff","path":"{{cwd}}/sub/Brief.docx","oldText":"brief","newText":"new"}]},"options":[{"optionId":"approved","name":"Yes","kind":"allow_once"},{"optionId":"approved-for-session","name":"Yes, for this session","kind":"allow_always"},{"optionId":"abort","name":"No","kind":"reject_once"}]}}}
{"expect_response":{"id":"perm-codex-diff","result":{"outcome":{"outcome":"selected","optionId":"abort"}}}}
