{"note":"Outside the matter folder: Word's owner file beside it is not checked, so the lawyer answers.","request":{"id":"perm-outside","method":"session/request_permission","params":{"sessionId":"sess-1","toolCall":{"toolCallId":"toolu_edit_6","title":"Edit `../outside/Invoice.docx`","kind":"edit","status":"pending","locations":[{"path":"{{cwd}}/../outside/Invoice.docx"}],"rawInput":{"file_path":"{{cwd}}/../outside/Invoice.docx","old_string":"a","new_string":"b"}},"options":[{"optionId":"allow_always","name":"Always Allow","kind":"allow_always"},{"optionId":"allow","name":"Allow","kind":"allow_once"},{"optionId":"reject","name":"Reject","kind":"reject_once"}]}}}
