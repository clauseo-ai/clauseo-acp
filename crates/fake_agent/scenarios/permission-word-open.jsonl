{"request":{"id":"perm-dotdot","method":"session/request_permission","params":{"sessionId":"sess-1","toolCall":{"toolCallId":"toolu_edit_4","title":"Edit `sub/../Invoice.docx`","kind":"edit","status":"pending","locations":[{"path":"{{cwd}}/sub/../Invoice.docx"}],"rawInput":{"file_path":"{{cwd}}/sub/../Invoice.docx","old_string":"a","new_string":"b"}},"options":[{"optionId":"allow_always","name":"Always Allow","kind":"allow_always"},{"optionId":"allow","name":"Allow","kind":"allow_once"},{"optionId":"reject","name":"Reject","kind":"reject_once"}]}}}
