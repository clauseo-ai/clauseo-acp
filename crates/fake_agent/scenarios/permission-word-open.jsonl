{"scenario":"permission-word-open","description":"Six edit requests: Invoice.docx (claude-agent-acp's shape) and sub/Brief.docx (codex-acp's) have Word owner files beside them and must be answered reject at once; Invoice.docx again offering no reject option must be answered cancelled; then Free.docx, ../outside/Invoice.docx and a request naming no path, which the lawyer answers allow, reject and allow","on_stdin_close":"exit"}
{"include":"handshake.jsonl"}
{"expect":{"method":"session/prompt","as":"p1","params":{"sessionId":"sess-1"}}}
{"request":{"id":"perm-claude","method":"session/request_permission","params":{"sessionId":"sess-1","toolCall":{"toolCallId":"toolu_edit_1","title":"Edit `Invoice.docx`","kind":"edit","status":"pending","locations":[{"path":"{{cwd}}/Invoice.docx"}],"rawInput":{"file_path":"{{cwd}}/Invoice.docx","old_string":"one","new_string":"two"}},"options":[{"optionId":"allow_always","name":"Always Allow","kind":"allow_always"},{"optionId":"allow","name":"Allow","kind":"allow_once"},{"optionId":"reject","name":"Reject","kind":"reject_once"}]}}}
{"expect_response":{"id":"perm-claude","result":{"outcome":{"outcome":"selected","optionId":"reject"}}}}
{"request":{"id":"perm-codex","method":"session/request_permission","params":{"sessionId":"sess-1","toolCall":{"toolCallId":"call_patch_1","title":"Edit sub/Brief.docx","kind":"edit","status":"pending","locations":[{"path":"{{cwd}}/sub/Brief.docx"}]},"options":[{"optionId":"approved","name":"Yes","kind":"allow_once"},{"optionId":"approved-for-session","name":"Yes, for this session","kind":"allow_always"},{"optionId":"abort","name":"No","kind":"reject_once"}]}}}
{"expect_response":{"id":"perm-codex","result":{"outcome":{"outcome":"selected","optionId":"abort"}}}}
{"request":{"id":"perm-no-reject","method":"session/request_permission","params":{"sessionId":"sess-1","toolCall":{"toolCallId":"toolu_edit_2","title":"Edit `Invoice.docx`","kind":"edit","status":"pending","locations":[{"path":"{{cwd}}/Invoice.docx"}]},"options":[{"optionId":"allow_always","name":"Always Allow","kind":"allow_always"},{"optionId":"allow","name":"Allow","kind":"allow_once"}]}}}
{"expect_response":{"id":"perm-no-reject","result":{"outcome":{"outcome":"cancelled"}}}}
{"request":{"id":"perm-free","method":"session/request_permission","params":{"sessionId":"sess-1","toolCall":{"toolCallId":"toolu_edit_3","title":"Edit `Free.docx`","kind":"edit","status":"pending","locations":[{"path":"{{cwd}}/Free.docx"}],"rawInput":{"file_path":"{{cwd}}/Free.docx","old_string":"a","new_string":"b"}},"options":[{"optionId":"allow_always","name":"Always Allow","kind":"allow_always"},{"optionId":"allow","name":"Allow","kind":"allow_once"},{"optionId":"reject","name":"Reject","kind":"reject_once"}]}}}
{"expect_response":{"id":"perm-free","result":{"outcome":{"outcome":"selected","optionId":"allow"}}}}
{"note":"Outside the matter folder: Word's owner file beside it is not checked, so the lawyer answers.","request":{"id":"perm-outside","method":"session/request_permission","params":{"sessionId":"sess-1","toolCall":{"toolCallId":"toolu_edit_4","title":"Edit `../outside/Invoice.docx`","kind":"edit","status":"pending","locations":[{"path":"{{cwd}}/../outside/Invoice.docx"}],"rawInput":{"file_path":"{{cwd}}/../outside/Invoice.docx","old_string":"a","new_string":"b"}},"options":[{"optionId":"allow_always","name":"Always Allow","kind":"allow_always"},{"optionId":"allow","name":"Allow","kind":"allow_once"},{"optionId":"reject","name":"Reject","kind":"reject_once"}]}}}
{"expect_response":{"id":"perm-outside","result":{"outcome":{"outcome":"selected","optionId":"reject"}}}}
{"request":{"id":"perm-no-path","method":"session/request_permission","params":{"sessionId":"sess-1","toolCall":{"toolCallId":"toolu_bash_1","title":"Run a command","kind":"edit","status":"pending"},"options":[{"optionId":"allow_always","name":"Always Allow","kind":"allow_always"},{"optionId":"allow","name":"Allow","kind":"allow_once"},{"optionId":"reject","name":"Reject","kind":"reject_once"}]}}}
{"expect_response":{"id":"perm-no-path","result":{"outcome":{"outcome":"selected","optionId":"allow"}}}}
{"update":{"update":{"sessionUpdate":"agent_message_chunk","messageId":"m-answer-1","content":{"type":"text","text":"Three edits were not made."}}}}
