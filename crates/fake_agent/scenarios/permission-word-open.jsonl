{"note":"Names no path: the host falls back to the paths its tool call named.","request":{"id":"perm-codex-known","method":"session/request_permission","params":{"sessionId":"sess-1","toolCall":{"toolCallId":"call_patch_2","title":"Edit sub/Brief.docx","kind":"edit","status":"pending","locations":[]},"options":[{"optionId":"approved","name":"Yes","kind":"allow_once"},{"optionId":"approved-for-session","name":"Yes, for this session","kind":"allow_always"},{"optionId":"abort","name":"No","kind":"reject_once"}]}}}
{"expect_response":{"id":"perm-codex-known","result":{"outcome":{"outcome":"selected","optionId":"abort"}}}}
{"request":{"id":"perm-no-reject","method":"session/request_permission","params":{"sessionId":"sess-1","toolCall":{"toolCallId":"toolu_edit_2","title":"Edit `Invoice.docx`","kind":"edit","status":"pending","locations":[{"path":"{{cwd}}/Invoice.docx"}],"rawInput":{"file_path":"{{cwd}}/Invoice.docx","old_string":"a","new_string":"b"}},"options":[{"optionId":"allow_always","name":"Always Allow","kind":"allow_always"},{"optionId":"allow","name":"Allow","kind":"allow_once"}]}}}
