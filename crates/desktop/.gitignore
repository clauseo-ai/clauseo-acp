# Written by tauri-build on every build.
/gen/
# The e2e and marks builds' command permissions: tauri-build writes them there, and a default build
# removes them again (build.rs), so they are never committed.
/permissions/autogenerated/perf_channel_bytes.toml
/permissions/autogenerated/marks_memory.toml
/permissions/autogenerated/marks_finish.toml
# Release builds only: .github/scripts/sidecars.mjs writes each sidecar for one target here, and
# the overlay that lists them (bundle.externalBin), which release.yml passes with --config.
/binaries/
/release/sidecars.generated.json
