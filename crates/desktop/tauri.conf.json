{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clauseo",
  "version": "0.1.0",
  "identifier": "ai.clauseo.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../ui/app/dist",
    "beforeDevCommand": "pnpm -C ../ui --filter @clauseo/app dev",
    "beforeBuildCommand": "pnpm -C ../ui --filter @clauseo/app build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "freezePrototype": true,
      "capabilities": ["main", "settings", "counts"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: clauseo-file: http://clauseo-file.localhost https://clauseo-file.localhost; font-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost; worker-src 'self'; frame-src 'self'; child-src 'self'; object-src 'none'; media-src 'none'; manifest-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types clauseo-sanitize"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "rpm"],
    "createUpdaterArtifacts": true,
    "publisher": "Clauseo",
    "copyright": "Copyright 2026 AI-CLAUSEO TECHNOLOGY PRIVATE LIMITED and contributors",
    "license": "GPL-3.0-or-later",
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "dmg": {}
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "minimumWebview2Version": "155.0.0.0",
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "headerImage": "icons/installer-header.bmp",
        "languages": ["English"],
        "customLanguageFiles": { "English": "windows/nsis/English.nsh" }
      }
    },
    "linux": {
      "deb": { "depends": [] },
      "rpm": {}
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": { "installMode": "passive" }
    }
  }
}
