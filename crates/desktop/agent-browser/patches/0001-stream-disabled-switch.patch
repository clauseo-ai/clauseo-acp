+/// Whether streaming is switched off with `AGENT_BROWSER_STREAM_DISABLED=1` (or
+/// `true`). Then the daemon starts no stream server and writes no `.stream`
+/// file, and `stream enable` fails: nothing listens on a loopback port.
+pub fn stream_disabled() -> bool {
+    stream_disabled_value(
+        std::env::var("AGENT_BROWSER_STREAM_DISABLED")
+            .ok()
+            .as_deref(),
+    )
+}
+
+fn stream_disabled_value(value: Option<&str>) -> bool {
+    value.is_some_and(|v| matches!(v.trim().to_ascii_lowercase().as_str(), "1" | "true"))
+}
