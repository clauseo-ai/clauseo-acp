--- a/cli/src/connection.rs
+++ b/cli/src/connection.rs
@@ -642,6 +642,8 @@ fn daemon_config_fingerprint(opts: &DaemonOptions) -> String {
     opts.idle_timeout.hash(&mut hasher);
     opts.default_timeout.hash(&mut hasher);
     opts.no_auto_dialog.hash(&mut hasher);
+    // A daemon started with streaming on is not reused by a CLI that has it off.
+    crate::native::stream::stream_disabled().hash(&mut hasher);
     format!("{:016x}", hasher.finish())
 }
 
