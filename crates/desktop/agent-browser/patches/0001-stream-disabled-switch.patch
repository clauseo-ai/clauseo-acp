+/// Whether streaming is switched off with `AGENT_BROWSER_STREAM_DISABLED=1` (or
+/// `true`). Then nothing listens on a loopback port: the daemon starts no
+/// stream server and writes no `.stream` file, `stream enable` fails, and
+/// `inspect` and `dashboard start` refuse to start their servers.
+pub fn stream_disabled() -> bool {
+    stream_disabled_value(
+        std::env::var("AGENT_BROWSER_STREAM_DISABLED")
+            .ok()
+            .as_deref(),
+    )
+}
+
+/// The error for a loopback server that `stream_disabled` keeps off.
+pub fn stream_disabled_error(what: &str) -> String {
+    format!("{} is disabled (AGENT_BROWSER_STREAM_DISABLED=1)", what)
+}
+
+fn stream_disabled_value(value: Option<&str>) -> bool {
+    value.is_some_and(|v| matches!(v.trim().to_ascii_lowercase().as_str(), "1" | "true"))
+}
