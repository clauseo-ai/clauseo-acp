+//! Tests for the daemon pipe. The key tests: a client without the key, or with a wrong one, is
+//! never served, and a client refuses a daemon of another session or key. A helper run of this
+//! test binary with the key, as a separate process, must be served.
+
+use super::*;
+use std::process::Command;
+
+const HELPER_ID: &str = "AB_PIPE_TEST_ID";
+const HELPER_PID: &str = "AB_PIPE_TEST_DAEMON_PID";
+const HELPER_CREATED: &str = "AB_PIPE_TEST_DAEMON_CREATED";
+const HELPER_KEY: &str = "AB_PIPE_TEST_KEY";
+const HELPER_TEST: &str = "windows_pipe::tests::pipe_client_helper";
+
+/// The session name and keys the tests use (test values, never a real session's).
+const SESSION: &str = "pipe-test";
+const KEY: &str = "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff";
+const OTHER_KEY: &str = "ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100";
+
+/// The helper's exit codes.
+const DISCONNECTED: i32 = 0;
+const COULD_NOT_OPEN: i32 = 1;
+const READ_TIMED_OUT: i32 = 11;
+const SERVED: i32 = 20;
+
+fn key() -> SessionKey {
+    SessionKey::parse(KEY).unwrap()
+}
+
+fn other_key() -> SessionKey {
+    SessionKey::parse(OTHER_KEY).unwrap()
+}
+
+fn this_process(id: &str) -> PipeRecord {
+    PipeRecord::for_this_process(id).unwrap()
+}
+
+fn bind(id: &str) -> PipeListener {
+    PipeListener::bind(id, SESSION, key()).unwrap()
+}
+
+/// The client end of pipe `id` with no check and no key exchange: what a process without the
+/// key, or upstream's client, gets.
+fn open_raw(id: &str) -> PipeStream {
+    PipeStream {
+        handle: open(id, Duration::from_secs(5)).expect("open"),
+        read_timeout: Some(Duration::from_secs(10)),
+        write_timeout: Some(Duration::from_secs(5)),
+    }
+}
+
+#[test]
+fn pipe_ids_are_128_random_bits_in_lowercase_hex() {
+    let a = new_pipe_id().unwrap();
+    let b = new_pipe_id().unwrap();
+    assert!(is_valid_pipe_id(&a) && is_valid_pipe_id(&b));
+    assert_ne!(a, b);
+    for bad in [
+        "",
+        "0123456789abcdef0123456789abcde",
+        "0123456789ABCDEF0123456789ABCDEF",
+        "0123456789abcdef0123456789abcdef0",
+        r"..\..\pipe\0123456789abcdef0123",
+        r"\\host\pipe\0123456789abcdef012",
+    ] {
+        assert!(!is_valid_pipe_id(bad), "{bad:?} must be refused");
+    }
+    assert_eq!(
+        pipe_path("0123456789abcdef0123456789abcdef"),
+        r"\\.\pipe\clauseo-ab-0123456789abcdef0123456789abcdef"
+    );
+}
+
+#[test]
+fn the_pipe_record_round_trips_and_only_a_keyed_record_is_read() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("s.pipe");
+    let record = this_process(&new_pipe_id().unwrap());
+    write_pipe_record(&path, &record, SESSION, &key()).unwrap();
+    assert_eq!(
+        read_pipe_record(&path, SESSION, &key()),
+        Some(record.clone())
+    );
+    // Another key or session: the record is not this session's.
+    assert_eq!(read_pipe_record(&path, SESSION, &other_key()), None);
+    assert_eq!(read_pipe_record(&path, "other", &key()), None);
+    let text = std::fs::read_to_string(&path).unwrap();
+    let mac = text.rsplit(' ').next().unwrap().to_string();
+    let fields = format!("{} {} {}", record.id, record.pid, record.created);
+    for bad in [
+        r"\\evil\pipe\x 1 2 00".to_string(),
+        record.id.clone(),
+        // A forged record without a MAC, or naming another live process with the old MAC.
+        fields.clone(),
+        format!("{} {} {} {mac}", record.id, record.pid + 4, record.created),
+        format!("{fields} {}", "0".repeat(64)),
+        format!("{fields} {mac} extra"),
+        format!("{} x {} {mac}", record.id, record.created),
+    ] {
+        std::fs::write(&path, &bad).unwrap();
+        assert_eq!(read_pipe_record(&path, SESSION, &key()), None, "{bad:?}");
+    }
+    assert!(!dir.path().join("s.pipe.partial").exists());
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn a_client_with_the_key_reaches_the_daemon_and_a_second_first_instance_fails() {
+    let id = new_pipe_id().unwrap();
+    let mut listener = bind(&id);
+    assert!(
+        PipeListener::bind(&id, SESSION, key()).is_err(),
+        "FILE_FLAG_FIRST_PIPE_INSTANCE must refuse"
+    );
+
+    let record = this_process(&id);
+    let client = tokio::task::spawn_blocking(move || {
+        let mut stream =
+            PipeStream::connect(&record, SESSION, &key(), Duration::from_secs(5)).expect("connect");
+        stream.set_read_timeout(Some(Duration::from_secs(10)));
+        stream.write_all(b"ping\n").unwrap();
+        let mut reply = [0u8; 5];
+        stream.read_exact(&mut reply).unwrap();
+        reply
+    });
+    let server = listener.accept().await.expect("accept");
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    let mut server = server;
+    let mut request = [0u8; 5];
+    server.read_exact(&mut request).await.unwrap();
+    assert_eq!(&request, b"ping\n");
+    server.write_all(b"pong\n").await.unwrap();
+    assert_eq!(&client.await.unwrap(), b"pong\n");
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn a_client_without_the_key_gets_the_challenge_and_nothing_else() {
+    let id = new_pipe_id().unwrap();
+    let mut listener = bind(&id);
+    let client = tokio::task::spawn_blocking(move || {
+        let mut stream = open_raw(&id);
+        let _ = stream.write_all(b"{\"id\":\"t\",\"action\":\"evaluate\",\"script\":\"1\"}\n");
+        let mut back = Vec::new();
+        let _ = stream.read_to_end(&mut back);
+        back.len()
+    });
+    let outcome = tokio::time::timeout(Duration::from_secs(30), async {
+        tokio::select! {
+            accepted = listener.accept() => Err(format!("accepted: {:?}", accepted.map(|_| ()))),
+            back = client => Ok(back.unwrap()),
+        }
+    })
+    .await
+    .expect("the client was neither refused nor accepted");
+    // The daemon's nonce and proof (64 bytes), then the end: no command was read.
+    assert_eq!(outcome, Ok(64));
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn a_client_with_a_wrong_key_is_refused() {
+    let id = new_pipe_id().unwrap();
+    let mut listener = bind(&id);
+    let record = this_process(&id);
+    let client = tokio::task::spawn_blocking(move || {
+        PipeStream::connect(&record, SESSION, &other_key(), Duration::from_secs(5)).map(|_| ())
+    });
+    let outcome = tokio::time::timeout(Duration::from_secs(30), async {
+        tokio::select! {
+            accepted = listener.accept() => Err(format!("accepted: {:?}", accepted.map(|_| ()))),
+            result = client => Ok(result.unwrap()),
+        }
+    })
+    .await
+    .expect("the client was neither refused nor accepted");
+    let error = outcome.unwrap().expect_err("a wrong key must be refused");
+    assert_eq!(error.kind(), io::ErrorKind::PermissionDenied);
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn the_client_refuses_a_daemon_of_another_session_or_key() {
+    // Two daemons in this process: session B's with this key, and this session's with another
+    // key. The client of this session, with this key, must refuse both.
+    let other_session = new_pipe_id().unwrap();
+    let other_keyed = new_pipe_id().unwrap();
+    let mut first = PipeListener::bind(&other_session, "another-session", key()).unwrap();
+    let mut second = PipeListener::bind(&other_keyed, SESSION, other_key()).unwrap();
+    let accept = tokio::spawn(async move {
+        loop {
+            tokio::select! {
+                a = first.accept() => if a.is_err() { break },
+                b = second.accept() => if b.is_err() { break },
+            }
+        }
+    });
+    let records = [this_process(&other_session), this_process(&other_keyed)];
+    let results = tokio::task::spawn_blocking(move || {
+        records
+            .map(|r| PipeStream::connect(&r, SESSION, &key(), Duration::from_secs(5)).map(|_| ()))
+    })
+    .await
+    .unwrap();
+    accept.abort();
+    for result in results {
+        let error = result.expect_err("a daemon of another session or key must be refused");
+        assert_eq!(error.kind(), io::ErrorKind::PermissionDenied);
+        assert!(error.to_string().contains("key"), "{error}");
+    }
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn several_clients_connect_at_once_without_waiting() {
+    let id = new_pipe_id().unwrap();
+    let mut listener = bind(&id);
+    let accept = tokio::spawn(async move {
+        let mut held = Vec::new();
+        while let Ok(server) = listener.accept().await {
+            held.push(server);
+        }
+    });
+    let record = this_process(&id);
+    let held = tokio::task::spawn_blocking(move || {
+        // No busy wait at all, and every connection is held: each must still find a
+        // listening instance.
+        (0..LISTENING_INSTANCES)
+            .map(|_| PipeStream::connect(&record, SESSION, &key(), Duration::ZERO))
+            .collect::<Vec<_>>()
+    })
+    .await
+    .unwrap();
+    accept.abort();
+    for result in held {
+        result.expect("a client found the pipe busy");
+    }
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn the_client_refuses_a_server_that_is_not_the_recorded_daemon() {
+    let id = new_pipe_id().unwrap();
+    let mut listener = bind(&id);
+    let accept = tokio::spawn(async move { while listener.accept().await.is_ok() {} });
+    let right = this_process(&id);
+    let wrong_pid = PipeRecord {
+        pid: right.pid.wrapping_add(4),
+        ..right.clone()
+    };
+    // The same pid with another creation time: a reused pid.
+    let reused_pid = PipeRecord {
+        created: right.created + 1,
+        ..right.clone()
+    };
+    let results = tokio::task::spawn_blocking(move || {
+        [wrong_pid, reused_pid]
+            .map(|r| PipeStream::connect(&r, SESSION, &key(), Duration::from_secs(5)).map(|_| ()))
+    })
+    .await
+    .unwrap();
+    accept.abort();
+    for result in results {
+        let error = result.expect_err("a server other than the recorded daemon must be refused");
+        assert_eq!(error.kind(), io::ErrorKind::PermissionDenied);
+    }
+}
+
+#[test]
+fn check_server_wants_the_same_executable() {
+    let id = new_pipe_id().unwrap();
+    check_server(std::process::id(), &this_process(&id)).expect("this process passes");
+
+    // Another executable, recorded correctly, is refused.
+    let system = std::env::var("SystemRoot").unwrap_or_else(|_| r"C:\Windows".to_string());
+    let mut ping = Command::new(format!(r"{system}\System32\ping.exe"))
+        .args(["-n", "30", "127.0.0.1"])
+        .stdout(std::process::Stdio::null())
+        .spawn()
+        .unwrap();
+    let other = PipeRecord {
+        id,
+        pid: ping.id(),
+        created: process_creation_time(ping.id()).unwrap(),
+    };
+    let other_image = check_server(ping.id(), &other);
+    let _ = ping.kill();
+    let _ = ping.wait();
+    assert!(other_image.unwrap_err().to_string().contains("executable"));
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn a_helper_with_the_key_is_served() {
+    use tokio::io::AsyncWriteExt;
+    let id = new_pipe_id().unwrap();
+    let mut listener = bind(&id);
+    let helper_id = id.clone();
+    let helper = tokio::task::spawn_blocking(move || run_helper(&helper_id));
+    let mut server = tokio::time::timeout(Duration::from_secs(60), listener.accept())
+        .await
+        .expect("the helper never connected")
+        .expect("accept");
+    server.write_all(b"ok\n").await.unwrap();
+    assert_eq!(helper.await.unwrap(), SERVED);
+}
+
+/// Run only as the child of the tests above (which set HELPER_ID); a no-op otherwise. With
+/// HELPER_KEY it connects as a client with the key; without, it opens the pipe raw and counts
+/// any byte back as served.
+#[test]
+fn pipe_client_helper() {
+    let Ok(id) = std::env::var(HELPER_ID) else {
+        return;
+    };
+    let record = PipeRecord {
+        id,
+        pid: std::env::var(HELPER_PID).unwrap().parse().unwrap(),
+        created: std::env::var(HELPER_CREATED).unwrap().parse().unwrap(),
+    };
+    let key = std::env::var(HELPER_KEY)
+        .ok()
+        .and_then(|k| SessionKey::parse(&k));
+    let stream = match &key {
+        Some(key) => PipeStream::connect(&record, SESSION, key, Duration::from_secs(5)),
+        None => open(&record.id, Duration::from_secs(5)).map(|handle| PipeStream {
+            handle,
+            read_timeout: None,
+            write_timeout: None,
+        }),
+    };
+    let code = match stream {
+        Err(_) => COULD_NOT_OPEN,
+        Ok(mut stream) => {
+            stream.set_read_timeout(Some(Duration::from_secs(10)));
+            stream.set_write_timeout(Some(Duration::from_secs(5)));
+            let _ = stream.write_all(b"{\"id\":\"t\",\"action\":\"url\"}\n");
+            let mut byte = [0u8; 1];
+            match stream.read(&mut byte) {
+                Ok(0) => DISCONNECTED,
+                Ok(_) => SERVED,
+                Err(e) if e.kind() == io::ErrorKind::TimedOut => READ_TIMED_OUT,
+                Err(_) => DISCONNECTED,
+            }
+        }
+    };
+    std::process::exit(code);
+}
+
+/// Starts this test binary as the pipe client, with the key, and returns its exit code.
+fn run_helper(id: &str) -> i32 {
+    let exe = std::env::current_exe().unwrap();
+    let daemon = this_process(id);
+    let status = Command::new(&exe)
+        .args(["--exact", HELPER_TEST, "--test-threads=1", "--quiet"])
+        .env(HELPER_ID, id)
+        .env(HELPER_PID, daemon.pid.to_string())
+        .env(HELPER_CREATED, daemon.created.to_string())
+        .env(HELPER_KEY, KEY)
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .status()
+        .unwrap();
+    status.code().unwrap()
+}
