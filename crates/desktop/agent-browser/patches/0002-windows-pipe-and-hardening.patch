new file mode 100644
index 0000000..4bd2c9f
--- /dev/null
+++ b/cli/src/session_key.rs
@@ -0,0 +1,339 @@
+//! The session key on Windows, which keeps every process without it off the daemon's pipe.
+//!
+//! The pipe's DACL lets in any process of the user, and its peer check refuses only restricted
+//! tokens, so an unsandboxed process of the same user could still send the daemon raw commands.
+//! The launcher (Clauseo's browser guard) therefore draws 32 random bytes per session and passes
+//! them in `AGENT_BROWSER_SESSION_KEY`, as 64 lowercase hex characters. Only the hardened
+//! processes hold the key:
+//!
+//! - `main` takes it out of this process's environment first thing ([`take_from_env`]), so no
+//!   child that std starts inherits it;
+//! - `spawn_hardened` puts it back for its children alone (the daemon, the MCP server's CLI
+//!   runs), each protected from creation;
+//! - it is never written to a file, put on a command line or printed.
+//!
+//! Each side proves the key without sending it. Every connection starts with this exchange,
+//! before any command ([`client_handshake`], [`server_handshake`]):
+//!
+//! 1. client: a fresh 32-byte nonce `c`;
+//! 2. daemon: a fresh nonce `s` and `HMAC-SHA256(key, "daemon" | session | c | s)`;
+//! 3. client: checks it (constant time), refusing a daemon of another session or key, then
+//!    sends `HMAC-SHA256(key, "client" | session | c | s)`;
+//! 4. daemon: checks it (constant time) and answers one byte; a client that fails is
+//!    disconnected before anything else is written.
+//!
+//! The daemon's `<session>.pipe` record carries `HMAC-SHA256(key, "record" | session | record)`
+//! too ([`record_mac`]): a record written without the key is ignored, so it can neither route a
+//! client nor pass for a live daemon.
+
+use std::fmt;
+use std::io::{self, Read, Write};
+use std::sync::OnceLock;
+use std::time::Duration;
+
+use hmac::{Hmac, Mac};
+use sha2::Sha256;
+
+/// The variable the launcher passes the key in.
+pub const ENV: &str = "AGENT_BROWSER_SESSION_KEY";
+
+const KEY_LEN: usize = 32;
+const NONCE_LEN: usize = 32;
+const MAC_LEN: usize = 32;
+/// The daemon's last byte of the exchange: the client is accepted.
+const ACCEPTED: u8 = 0x2b;
+/// How long either side waits for the other during the exchange.
+pub const HANDSHAKE_TIMEOUT: Duration = Duration::from_secs(5);
+
+/// Which proof a MAC is: the roles differ so that one can never stand in for another.
+const DAEMON: &[u8] = b"agent-browser pipe daemon v1";
+const CLIENT: &[u8] = b"agent-browser pipe client v1";
+const RECORD: &[u8] = b"agent-browser pipe record v1";
+
+type HmacSha256 = Hmac<Sha256>;
+
+/// The session's 32-byte key. Its Debug output shows nothing of it.
+#[derive(Clone, PartialEq, Eq)]
+pub struct SessionKey([u8; KEY_LEN]);
+
+impl fmt::Debug for SessionKey {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("SessionKey(..)")
+    }
+}
+
+impl SessionKey {
+    /// Exactly 64 lowercase hex characters; anything else is None.
+    pub fn parse(text: &str) -> Option<Self> {
+        let text = text.as_bytes();
+        if text.len() != KEY_LEN * 2 {
+            return None;
+        }
+        let mut key = [0u8; KEY_LEN];
+        for (byte, [high, low]) in key.iter_mut().zip(text.as_chunks::<2>().0) {
+            *byte = (nibble(*high)? << 4) | nibble(*low)?;
+        }
+        Some(Self(key))
+    }
+
+    /// The form [`parse`](Self::parse) reads, for a hardened child's environment only.
+    pub fn to_hex(&self) -> String {
+        hex::encode(self.0)
+    }
+
+    /// The MAC for `role` over the session name and the parts, each part length-prefixed so
+    /// that no two different inputs give the same message.
+    fn mac(&self, role: &[u8], session: &str, parts: &[&[u8]]) -> HmacSha256 {
+        let mut mac = HmacSha256::new_from_slice(&self.0).expect("HMAC takes any key length");
+        for part in [role, session.as_bytes()].iter().chain(parts) {
+            mac.update(&(part.len() as u64).to_be_bytes());
+            mac.update(part);
+        }
+        mac
+    }
+}
+
+fn nibble(c: u8) -> Option<u8> {
+    match c {
+        b'0'..=b'9' => Some(c - b'0'),
+        b'a'..=b'f' => Some(c - b'a' + 10),
+        _ => None,
+    }
+}
+
+static KEY: OnceLock<Option<SessionKey>> = OnceLock::new();
+
+/// Reads the key from the environment and removes the variable from this process's
+/// environment, so no child started without `spawn_hardened` inherits it. Called first thing
+/// in `main`, while the process has one thread. An invalid value counts as no key.
+pub fn take_from_env() {
+    let _ = KEY.set(take(ENV));
+}
+
+/// The key in variable `name`, which is removed from this process's environment.
+fn take(name: &str) -> Option<SessionKey> {
+    let key = std::env::var(name).ok().and_then(|v| SessionKey::parse(&v));
+    std::env::remove_var(name);
+    key
+}
+
+/// This process's key, if it was given a valid one.
+pub fn session_key() -> Option<&'static SessionKey> {
+    KEY.get_or_init(|| std::env::var(ENV).ok().and_then(|v| SessionKey::parse(&v)))
+        .as_ref()
+}
+
+/// The error for a process with no key.
+pub fn no_key_error() -> String {
+    format!(
+        "{ENV} is not set or not 64 lowercase hex characters; on Windows this build talks only \
+         to a daemon started with its session's key"
+    )
+}
+
+fn refused(why: &str) -> io::Error {
+    io::Error::new(io::ErrorKind::PermissionDenied, why.to_string())
+}
+
+fn nonce() -> io::Result<[u8; NONCE_LEN]> {
+    let mut nonce = [0u8; NONCE_LEN];
+    getrandom::getrandom(&mut nonce).map_err(|e| io::Error::other(e.to_string()))?;
+    Ok(nonce)
+}
+
+/// The MAC the daemon puts in its `<session>.pipe` record over the record's text `fields`.
+pub fn record_mac(key: &SessionKey, session: &str, fields: &str) -> String {
+    hex::encode(
+        key.mac(RECORD, session, &[fields.as_bytes()])
+            .finalize()
+            .into_bytes(),
+    )
+}
+
+/// Whether `mac` (hex) is [`record_mac`] of `fields`, compared in constant time.
+pub fn record_mac_matches(key: &SessionKey, session: &str, fields: &str, mac: &str) -> bool {
+    let Ok(mac) = hex::decode(mac) else {
+        return false;
+    };
+    key.mac(RECORD, session, &[fields.as_bytes()])
+        .verify_slice(&mac)
+        .is_ok()
+}
+
+/// The client's side of the exchange, on a stream whose reads and writes time out. Fails, as
+/// PermissionDenied, when the daemon does not prove the key or does not accept ours.
+pub fn client_handshake(
+    stream: &mut (impl Read + Write),
+    key: &SessionKey,
+    session: &str,
+) -> io::Result<()> {
+    let client = nonce()?;
+    stream.write_all(&client)?;
+    let mut reply = [0u8; NONCE_LEN + MAC_LEN];
+    stream
+        .read_exact(&mut reply)
+        .map_err(|_| refused("the pipe's server ended the session key exchange"))?;
+    let (server, proof) = reply.split_at(NONCE_LEN);
+    key.mac(DAEMON, session, &[&client, server])
+        .verify_slice(proof)
+        .map_err(|_| refused("the pipe's server does not hold this session's key"))?;
+    let ours = key.mac(CLIENT, session, &[&client, server]).finalize();
+    stream.write_all(&ours.into_bytes())?;
+    let mut answer = [0u8; 1];
+    match stream.read_exact(&mut answer) {
+        Ok(()) if answer[0] == ACCEPTED => Ok(()),
+        _ => Err(refused("the daemon refused this client's session key")),
+    }
+}
+
+/// The daemon's side of the exchange. Fails, as PermissionDenied, when the client does not
+/// prove the key; the caller then disconnects it without writing anything else.
+pub async fn server_handshake<S>(stream: &mut S, key: &SessionKey, session: &str) -> io::Result<()>
+where
+    S: tokio::io::AsyncRead + tokio::io::AsyncWrite + Unpin,
+{
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    let mut client = [0u8; NONCE_LEN];
+    stream.read_exact(&mut client).await?;
+    let server = nonce()?;
+    let proof = key.mac(DAEMON, session, &[&client, &server]).finalize();
+    let mut reply = Vec::with_capacity(NONCE_LEN + MAC_LEN);
+    reply.extend_from_slice(&server);
+    reply.extend_from_slice(&proof.into_bytes());
+    stream.write_all(&reply).await?;
+    let mut theirs = [0u8; MAC_LEN];
+    stream.read_exact(&mut theirs).await?;
+    key.mac(CLIENT, session, &[&client, &server])
+        .verify_slice(&theirs)
+        .map_err(|_| refused("the client does not hold this session's key"))?;
+    stream.write_all(&[ACCEPTED]).await
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const HEX: &str = "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff";
+
+    fn key(hex: &str) -> SessionKey {
+        SessionKey::parse(hex).unwrap()
+    }
+
+    #[test]
+    fn only_64_lowercase_hex_characters_make_a_key() {
+        assert_eq!(key(HEX).to_hex(), HEX);
+        for bad in [
+            "",
+            &HEX[1..],
+            &format!("{HEX}0"),
+            &HEX.to_uppercase(),
+            &HEX.replace('0', "g"),
+            &HEX.replace("00", "é"),
+        ] {
+            assert!(SessionKey::parse(bad).is_none(), "{bad:?}");
+        }
+        assert_eq!(format!("{:?}", key(HEX)), "SessionKey(..)");
+    }
+
+    #[test]
+    fn the_record_mac_binds_the_key_the_session_and_the_fields() {
+        let k = key(HEX);
+        let other = key(&HEX.replace('f', "e"));
+        let mac = record_mac(&k, "s", "a 1 2");
+        assert!(record_mac_matches(&k, "s", "a 1 2", &mac));
+        assert!(!record_mac_matches(&other, "s", "a 1 2", &mac));
+        assert!(!record_mac_matches(&k, "t", "a 1 2", &mac));
+        assert!(!record_mac_matches(&k, "s", "a 1 3", &mac));
+        assert!(!record_mac_matches(&k, "s", "a 1 2", "zz"));
+        assert!(!record_mac_matches(&k, "s", "a 1 2", &mac[..62]));
+    }
+
+    /// Runs both sides over a socket pair: the daemon's with `daemon`, the client's with
+    /// `client` (None: a client that sends a command at once, as one without the key would).
+    #[cfg(unix)]
+    fn exchange(
+        daemon: (&SessionKey, &str),
+        client: Option<(&SessionKey, &str)>,
+    ) -> (io::Result<()>, io::Result<()>) {
+        let (ours, theirs) = std::os::unix::net::UnixStream::pair().unwrap();
+        for stream in [&ours, &theirs] {
+            stream.set_read_timeout(Some(HANDSHAKE_TIMEOUT)).unwrap();
+        }
+        theirs.set_nonblocking(true).unwrap();
+        let (key, session) = (daemon.0.clone(), daemon.1.to_string());
+        let server = std::thread::spawn(move || {
+            let runtime = tokio::runtime::Builder::new_current_thread()
+                .enable_all()
+                .build()
+                .unwrap();
+            runtime.block_on(async move {
+                let mut stream = tokio::net::UnixStream::from_std(theirs).unwrap();
+                let result = tokio::time::timeout(
+                    HANDSHAKE_TIMEOUT,
+                    server_handshake(&mut stream, &key, &session),
+                )
+                .await
+                .unwrap_or_else(|_| Err(io::ErrorKind::TimedOut.into()));
+                drop(stream);
+                result
+            })
+        });
+        let mut ours = ours;
+        let client = match client {
+            Some((key, session)) => client_handshake(&mut ours, key, session),
+            None => {
+                ours.write_all(b"{\"id\":\"1\",\"action\":\"evaluate\",\"script\":\"1\"}\n")
+                    .unwrap();
+                ours.shutdown(std::net::Shutdown::Write).unwrap();
+                let mut rest = Vec::new();
+                let _ = ours.read_to_end(&mut rest);
+                Err(io::Error::other(format!("{} bytes back", rest.len())))
+            }
+        };
+        drop(ours);
+        (server.join().unwrap(), client)
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn the_right_key_passes_both_ways() {
+        let k = key(HEX);
+        let (daemon, client) = exchange((&k, "s"), Some((&k, "s")));
+        daemon.expect("the daemon accepts");
+        client.expect("the client accepts");
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn a_wrong_key_or_session_is_refused_by_the_client_first() {
+        let k = key(HEX);
+        let other = key(&HEX.replace('a', "b"));
+        for client in [(&other, "s"), (&k, "t")] {
+            let (daemon, client) = exchange((&k, "s"), Some(client));
+            assert_eq!(client.unwrap_err().kind(), io::ErrorKind::PermissionDenied);
+            assert!(daemon.is_err(), "the daemon must not accept");
+        }
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn a_client_without_the_key_gets_no_reply_but_the_challenge() {
+        let k = key(HEX);
+        let (daemon, client) = exchange((&k, "s"), None);
+        assert!(daemon.is_err(), "the daemon must not accept");
+        // The daemon's nonce and proof only (64 bytes): never a command's reply.
+        assert_eq!(client.unwrap_err().to_string(), "64 bytes back");
+    }
+
+    #[test]
+    fn taking_the_key_removes_the_variable() {
+        // A name of this test's own: the process's key stays unset for the other tests.
+        const NAME: &str = "AB_SESSION_KEY_TAKE_TEST";
+        std::env::set_var(NAME, HEX);
+        assert_eq!(take(NAME), Some(key(HEX)));
+        assert!(std::env::var_os(NAME).is_none());
+        std::env::set_var(NAME, HEX.to_uppercase());
+        assert_eq!(take(NAME), None);
+        assert!(std::env::var_os(NAME).is_none());
+    }
+}
