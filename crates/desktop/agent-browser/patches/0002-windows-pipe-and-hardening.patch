+//! Tests for the daemon pipe. The restricted-client test starts this test binary again as the
+//! client, under a write-restricted token made with CreateRestrictedToken (as Codex's Windows
+//! sandbox runs its commands), and checks that the daemon disconnects it before writing
+//! anything; a control run with the normal token must be served.
+
+use super::*;
+use std::os::windows::ffi::OsStrExt;
+use std::process::Command;
+
+const HELPER_ID: &str = "AB_PIPE_TEST_ID";
+const HELPER_PID: &str = "AB_PIPE_TEST_DAEMON_PID";
+const HELPER_TEST: &str = "windows_pipe::tests::pipe_client_helper";
+
+/// The helper's exit codes.
+const DISCONNECTED: i32 = 0;
+const COULD_NOT_OPEN: i32 = 1;
+const READ_TIMED_OUT: i32 = 11;
+const SERVED: i32 = 20;
+
+#[test]
+fn pipe_ids_are_128_random_bits_in_lowercase_hex() {
+    let a = new_pipe_id().unwrap();
+    let b = new_pipe_id().unwrap();
+    assert!(is_valid_pipe_id(&a) && is_valid_pipe_id(&b));
+    assert_ne!(a, b);
+    for bad in [
+        "",
+        "0123456789abcdef0123456789abcde",
+        "0123456789ABCDEF0123456789ABCDEF",
+        "0123456789abcdef0123456789abcdef0",
+        r"..\..\pipe\0123456789abcdef0123",
+        r"\\host\pipe\0123456789abcdef012",
+    ] {
+        assert!(!is_valid_pipe_id(bad), "{bad:?} must be refused");
+    }
+    assert_eq!(
+        pipe_path("0123456789abcdef0123456789abcdef"),
+        r"\\.\pipe\clauseo-ab-0123456789abcdef0123456789abcdef"
+    );
+}
+
+#[test]
+fn the_pipe_file_round_trips_and_garbage_is_ignored() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("s.pipe");
+    let id = new_pipe_id().unwrap();
+    write_pipe_id(&path, &id).unwrap();
+    assert_eq!(read_pipe_id(&path), Some(id));
+    std::fs::write(&path, r"\\evil\pipe\x").unwrap();
+    assert_eq!(read_pipe_id(&path), None);
+    assert!(!dir.path().join("s.pipe.partial").exists());
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn a_client_reaches_the_daemon_and_a_second_first_instance_fails() {
+    let id = new_pipe_id().unwrap();
+    let mut listener = PipeListener::bind(&id).unwrap();
+    assert!(
+        PipeListener::bind(&id).is_err(),
+        "FILE_FLAG_FIRST_PIPE_INSTANCE must refuse"
+    );
+
+    let client_id = id.clone();
+    let client = tokio::task::spawn_blocking(move || {
+        let mut stream =
+            PipeStream::connect(&client_id, std::process::id(), Duration::from_secs(5))
+                .expect("connect");
+        stream.set_read_timeout(Some(Duration::from_secs(10)));
+        stream.write_all(b"ping\n").unwrap();
+        let mut reply = [0u8; 5];
+        stream.read_exact(&mut reply).unwrap();
+        reply
+    });
+    let server = listener.accept().await.expect("accept");
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    let mut server = server;
+    let mut request = [0u8; 5];
+    server.read_exact(&mut request).await.unwrap();
+    assert_eq!(&request, b"ping\n");
+    server.write_all(b"pong\n").await.unwrap();
+    assert_eq!(&client.await.unwrap(), b"pong\n");
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn the_client_refuses_a_server_that_is_not_the_daemon() {
+    let id = new_pipe_id().unwrap();
+    let mut listener = PipeListener::bind(&id).unwrap();
+    let accept = tokio::spawn(async move {
+        let _ = listener.accept().await;
+    });
+    let wrong_pid = std::process::id().wrapping_add(4);
+    let result = tokio::task::spawn_blocking(move || {
+        PipeStream::connect(&id, wrong_pid, Duration::from_secs(5)).map(|_| ())
+    })
+    .await
+    .unwrap();
+    accept.abort();
+    let error = result.expect_err("a server other than the daemon must be refused");
+    assert_eq!(error.kind(), io::ErrorKind::PermissionDenied);
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn a_restricted_token_client_is_disconnected_before_any_byte() {
+    let id = new_pipe_id().unwrap();
+    let mut listener = PipeListener::bind(&id).unwrap();
+    let helper_id = id.clone();
+    let mut helper = tokio::task::spawn_blocking(move || run_helper(&helper_id, true));
+    let outcome = tokio::time::timeout(Duration::from_secs(60), async {
+        tokio::select! {
+            accepted = listener.accept() => Err(format!("accepted: {:?}", accepted.map(|_| ()))),
+            code = &mut helper => Ok(code.unwrap()),
+        }
+    })
+    .await
+    .expect("the restricted client neither finished nor was accepted");
+    assert_eq!(
+        outcome,
+        Ok(DISCONNECTED),
+        "1 = could not open, 11 = held open, 20 = served"
+    );
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn control_an_unrestricted_helper_is_served() {
+    use tokio::io::AsyncWriteExt;
+    let id = new_pipe_id().unwrap();
+    let mut listener = PipeListener::bind(&id).unwrap();
+    let helper_id = id.clone();
+    let helper = tokio::task::spawn_blocking(move || run_helper(&helper_id, false));
+    let mut server = tokio::time::timeout(Duration::from_secs(60), listener.accept())
+        .await
+        .expect("the unrestricted helper never connected")
+        .expect("accept");
+    server.write_all(b"ok\n").await.unwrap();
+    assert_eq!(helper.await.unwrap(), SERVED);
+}
+
+/// Run only as the child of the tests above (which set HELPER_ID); a no-op otherwise.
+#[test]
+fn pipe_client_helper() {
+    let Ok(id) = std::env::var(HELPER_ID) else {
+        return;
+    };
+    let pid: u32 = std::env::var(HELPER_PID).unwrap().parse().unwrap();
+    let code = match PipeStream::connect(&id, pid, Duration::from_secs(5)) {
+        Err(_) => COULD_NOT_OPEN,
+        Ok(mut stream) => {
+            stream.set_read_timeout(Some(Duration::from_secs(10)));
+            stream.set_write_timeout(Some(Duration::from_secs(5)));
+            let _ = stream.write_all(b"{\"id\":\"t\",\"action\":\"url\"}\n");
+            let mut byte = [0u8; 1];
+            match stream.read(&mut byte) {
+                Ok(0) => DISCONNECTED,
+                Ok(_) => SERVED,
+                Err(e) if e.kind() == io::ErrorKind::TimedOut => READ_TIMED_OUT,
+                Err(_) => DISCONNECTED,
+            }
+        }
+    };
+    std::process::exit(code);
+}
+
+/// Starts this test binary as the pipe client and returns its exit code.
+fn run_helper(id: &str, restricted: bool) -> i32 {
+    let exe = std::env::current_exe().unwrap();
+    let mut command = Command::new(&exe);
+    command
+        .args(["--exact", HELPER_TEST, "--test-threads=1", "--quiet"])
+        .env(HELPER_ID, id)
+        .env(HELPER_PID, std::process::id().to_string());
+    if !restricted {
+        let status = command
+            .stdout(std::process::Stdio::null())
+            .stderr(std::process::Stdio::null())
+            .status()
+            .unwrap();
+        return status.code().unwrap();
+    }
+    restricted::run(&command)
+}
+
+mod restricted {
+    use super::*;
+    use crate::windows_spawn::{command_line, environment_block};
+    use windows_sys::Win32::Foundation::{CloseHandle, LocalFree, PSID};
+    use windows_sys::Win32::Security::Authorization::ConvertStringSidToSidW;
+    use windows_sys::Win32::Security::{
+        CreateRestrictedToken, SID_AND_ATTRIBUTES, TOKEN_ASSIGN_PRIMARY, TOKEN_DUPLICATE,
+        TOKEN_QUERY, WRITE_RESTRICTED,
+    };
+    use windows_sys::Win32::System::Threading::{
+        CreateProcessAsUserW, GetCurrentProcess, GetExitCodeProcess, OpenProcessToken,
+        CREATE_NO_WINDOW, CREATE_UNICODE_ENVIRONMENT, PROCESS_INFORMATION, STARTUPINFOW,
+    };
+
+    /// Runs `command` under a write-restricted copy of this process's token whose restricting
+    /// SIDs are the user and Everyone, and returns its exit code.
+    pub fn run(command: &Command) -> i32 {
+        let token = restricted_token();
+        let program = command.get_program().to_owned();
+        let mut line = command_line(&program, command.get_args()).unwrap();
+        let app: Vec<u16> = program.encode_wide().chain(Some(0)).collect();
+        let environment = environment_block(command).unwrap();
+        let mut startup: STARTUPINFOW = unsafe { mem::zeroed() };
+        startup.cb = mem::size_of::<STARTUPINFOW>() as u32;
+        let mut info: PROCESS_INFORMATION = unsafe { mem::zeroed() };
+        let ok = unsafe {
+            CreateProcessAsUserW(
+                raw(&token),
+                app.as_ptr(),
+                line.as_mut_ptr(),
+                ptr::null(),
+                ptr::null(),
+                0,
+                CREATE_NO_WINDOW | CREATE_UNICODE_ENVIRONMENT,
+                environment.as_ptr().cast(),
+                ptr::null(),
+                &startup,
+                &mut info,
+            )
+        };
+        assert_ne!(
+            ok,
+            0,
+            "CreateProcessAsUserW: {}",
+            io::Error::last_os_error()
+        );
+        let mut code = 0u32;
+        unsafe {
+            CloseHandle(info.hThread);
+            WaitForSingleObject(info.hProcess, INFINITE);
+            GetExitCodeProcess(info.hProcess, &mut code);
+            CloseHandle(info.hProcess);
+        }
+        code as i32
+    }
+
+    fn restricted_token() -> OwnedHandle {
+        let mut token: HANDLE = 0;
+        let access = TOKEN_DUPLICATE | TOKEN_QUERY | TOKEN_ASSIGN_PRIMARY;
+        assert_ne!(
+            unsafe { OpenProcessToken(GetCurrentProcess(), access, &mut token) },
+            0
+        );
+        let token = unsafe { OwnedHandle::from_raw_handle(token as _) };
+        let user = crate::windows_security::current_user_sid().unwrap();
+        let sids: Vec<PSID> = [user.as_str(), "S-1-1-0"].iter().map(|s| sid(s)).collect();
+        let restricting: Vec<SID_AND_ATTRIBUTES> = sids
+            .iter()
+            .map(|&sid| SID_AND_ATTRIBUTES {
+                Sid: sid,
+                Attributes: 0,
+            })
+            .collect();
+        let mut restricted: HANDLE = 0;
+        let ok = unsafe {
+            CreateRestrictedToken(
+                raw(&token),
+                WRITE_RESTRICTED,
+                0,
+                ptr::null(),
+                0,
+                ptr::null(),
+                restricting.len() as u32,
+                restricting.as_ptr(),
+                &mut restricted,
+            )
+        };
+        for sid in sids {
+            unsafe { LocalFree(sid) };
+        }
+        assert_ne!(
+            ok,
+            0,
+            "CreateRestrictedToken: {}",
+            io::Error::last_os_error()
+        );
+        unsafe { OwnedHandle::from_raw_handle(restricted as _) }
+    }
+
+    fn sid(text: &str) -> PSID {
+        let wide = to_wide(text);
+        let mut sid: PSID = ptr::null_mut();
+        assert_ne!(
+            unsafe { ConvertStringSidToSidW(wide.as_ptr(), &mut sid) },
+            0
+        );
+        sid
+    }
+}
diff --git a/cli/src/windows_security.rs b/cli/src/windows_security.rs
new file mode 100644
index 0000000..841c316
--- /dev/null
+++ b/cli/src/windows_security.rs
@@ -0,0 +1,263 @@
+//! Windows process and pipe security.
+//!
+//! Every agent-browser process protects itself first thing in `main`: its DACL lets SYSTEM do
+//! anything, and lets the user (and OWNER RIGHTS, which caps the owner's implicit rights) only
+//! query limited information and wait on it. Another process of the same user, sandboxed or
+//! not, then cannot read its memory, duplicate its handles, inject a thread or change the DACL.
+//! The children agent-browser starts get the same descriptor at creation (`windows_spawn`), so
+//! they are protected from their first instruction.
+//!
+//! The daemon's named pipe gets a DACL for the user and SYSTEM only (`windows_pipe`), and the
+//! daemon refuses any client whose token is restricted, as a sandbox's is.
+
+use std::io;
+use std::os::windows::io::{FromRawHandle, OwnedHandle};
+use std::ptr;
+
+use windows_sys::Win32::Foundation::{
+    GetLastError, LocalFree, SetLastError, ERROR_INSUFFICIENT_BUFFER, ERROR_SUCCESS, HANDLE,
+};
+use windows_sys::Win32::Security::Authorization::{
+    ConvertSidToStringSidW, ConvertStringSecurityDescriptorToSecurityDescriptorW, SetSecurityInfo,
+    SDDL_REVISION_1, SE_KERNEL_OBJECT,
+};
+use windows_sys::Win32::Security::{
+    GetSecurityDescriptorDacl, GetTokenInformation, IsTokenRestricted, TokenUser, ACL,
+    DACL_SECURITY_INFORMATION, PROTECTED_DACL_SECURITY_INFORMATION, PSECURITY_DESCRIPTOR,
+    SECURITY_ATTRIBUTES, TOKEN_QUERY, TOKEN_USER,
+};
+use windows_sys::Win32::System::Threading::{
+    GetCurrentProcess, OpenProcess, OpenProcessToken, PROCESS_QUERY_LIMITED_INFORMATION,
+};
+
+/// The protected process DACL: SYSTEM gets PROCESS_ALL_ACCESS; the user and OWNER RIGHTS get
+/// PROCESS_QUERY_LIMITED_INFORMATION | SYNCHRONIZE (0x101000) and nothing else.
+pub fn process_sddl(user_sid: &str) -> String {
+    format!("D:P(A;;0x1FFFFF;;;SY)(A;;0x101000;;;{user_sid})(A;;0x101000;;;OW)")
+}
+
+/// The daemon pipe's protected DACL: full access for SYSTEM and the user, nobody else.
+pub fn pipe_sddl(user_sid: &str) -> String {
+    format!("D:P(A;;GA;;;SY)(A;;GA;;;{user_sid})")
+}
+
+/// A security descriptor built from SDDL, freed on drop.
+pub struct SecurityDescriptor(PSECURITY_DESCRIPTOR);
+
+// The descriptor is never changed after it is built, and LocalFree may run on any thread.
+unsafe impl Send for SecurityDescriptor {}
+unsafe impl Sync for SecurityDescriptor {}
+
+impl SecurityDescriptor {
+    pub fn from_sddl(sddl: &str) -> io::Result<Self> {
+        let wide = to_wide(sddl);
+        let mut descriptor: PSECURITY_DESCRIPTOR = ptr::null_mut();
+        let ok = unsafe {
+            ConvertStringSecurityDescriptorToSecurityDescriptorW(
+                wide.as_ptr(),
+                SDDL_REVISION_1,
+                &mut descriptor,
+                ptr::null_mut(),
+            )
+        };
+        if ok == 0 || descriptor.is_null() {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(Self(descriptor))
+    }
+
+    /// Non-inheritable SECURITY_ATTRIBUTES pointing at this descriptor. They borrow it: keep
+    /// the descriptor alive while the attributes are in use.
+    pub fn attributes(&self) -> SECURITY_ATTRIBUTES {
+        SECURITY_ATTRIBUTES {
+            nLength: std::mem::size_of::<SECURITY_ATTRIBUTES>() as u32,
+            lpSecurityDescriptor: self.0,
+            bInheritHandle: 0,
+        }
+    }
+
+    fn dacl(&self) -> io::Result<*mut ACL> {
+        let mut present = 0;
+        let mut defaulted = 0;
+        let mut dacl: *mut ACL = ptr::null_mut();
+        let ok =
+            unsafe { GetSecurityDescriptorDacl(self.0, &mut present, &mut dacl, &mut defaulted) };
+        if ok == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        if present == 0 || dacl.is_null() {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "descriptor has no DACL",
+            ));
+        }
+        Ok(dacl)
+    }
+}
+
+impl Drop for SecurityDescriptor {
+    fn drop(&mut self) {
+        unsafe { LocalFree(self.0) };
+    }
+}
+
+/// The descriptor every agent-browser process and child gets (`process_sddl`).
+pub fn process_descriptor() -> io::Result<SecurityDescriptor> {
+    SecurityDescriptor::from_sddl(&process_sddl(&current_user_sid()?))
+}
+
+/// The descriptor of the daemon's pipe (`pipe_sddl`).
+pub fn pipe_descriptor() -> io::Result<SecurityDescriptor> {
+    SecurityDescriptor::from_sddl(&pipe_sddl(&current_user_sid()?))
+}
+
+/// Replaces this process's DACL with the protected one. Called first thing in `main`.
+pub fn harden_current_process() -> io::Result<()> {
+    let descriptor = process_descriptor()?;
+    let dacl = descriptor.dacl()?;
+    let status = unsafe {
+        SetSecurityInfo(
+            GetCurrentProcess(),
+            SE_KERNEL_OBJECT,
+            DACL_SECURITY_INFORMATION | PROTECTED_DACL_SECURITY_INFORMATION,
+            ptr::null_mut(),
+            ptr::null_mut(),
+            dacl,
+            ptr::null(),
+        )
+    };
+    if status != ERROR_SUCCESS {
+        return Err(io::Error::from_raw_os_error(status as i32));
+    }
+    Ok(())
+}
+
+/// The user SID of this process's token, as `S-1-...`.
+pub fn current_user_sid() -> io::Result<String> {
+    let token = open_process_token(unsafe { GetCurrentProcess() })?;
+    let sid = token_user_sid(&token)?;
+    // The SID goes into SDDL: anything but a plain S-1-... string is refused.
+    let plain = sid.starts_with("S-1-")
+        && sid
+            .bytes()
+            .all(|b| b.is_ascii_digit() || b == b'-' || b == b'S');
+    if !plain {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "unexpected user SID",
+        ));
+    }
+    Ok(sid)
+}
+
+/// Whether process `pid` runs with a restricted token (one with restricting SIDs, as a sandbox's
+/// write-restricted token has). Fails closed: anything that cannot be checked counts as
+/// restricted.
+pub fn process_token_is_restricted(pid: u32) -> bool {
+    let process = unsafe { OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, 0, pid) };
+    if process == 0 {
+        return true;
+    }
+    let process = unsafe { OwnedHandle::from_raw_handle(process as _) };
+    let Ok(token) = open_process_token(raw(&process)) else {
+        return true;
+    };
+    unsafe {
+        SetLastError(0);
+        if IsTokenRestricted(raw(&token)) != 0 {
+            return true;
+        }
+        // Zero is both "not restricted" and a failure; only a clean zero passes.
+        GetLastError() != 0
+    }
+}
+
+fn open_process_token(process: HANDLE) -> io::Result<OwnedHandle> {
+    let mut token: HANDLE = 0;
+    if unsafe { OpenProcessToken(process, TOKEN_QUERY, &mut token) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(unsafe { OwnedHandle::from_raw_handle(token as _) })
+}
+
+fn token_user_sid(token: &OwnedHandle) -> io::Result<String> {
+    let mut len = 0u32;
+    unsafe { GetTokenInformation(raw(token), TokenUser, ptr::null_mut(), 0, &mut len) };
+    if len == 0 || unsafe { GetLastError() } != ERROR_INSUFFICIENT_BUFFER {
+        return Err(io::Error::last_os_error());
+    }
+    // u64s keep TOKEN_USER's pointer aligned.
+    let mut buf = vec![0u64; (len as usize).div_ceil(8)];
+    let ok = unsafe {
+        GetTokenInformation(
+            raw(token),
+            TokenUser,
+            buf.as_mut_ptr().cast(),
+            len,
+            &mut len,
+        )
+    };
+    if ok == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let user = unsafe { &*(buf.as_ptr() as *const TOKEN_USER) };
+    let mut text: *mut u16 = ptr::null_mut();
+    if unsafe { ConvertSidToStringSidW(user.User.Sid, &mut text) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let sid = unsafe { from_wide_ptr(text) };
+    unsafe { LocalFree(text.cast()) };
+    Ok(sid)
+}
+
+pub(crate) fn raw(handle: &OwnedHandle) -> HANDLE {
+    use std::os::windows::io::AsRawHandle;
+    handle.as_raw_handle() as HANDLE
+}
+
+pub(crate) fn to_wide(text: &str) -> Vec<u16> {
+    text.encode_utf16().chain(std::iter::once(0)).collect()
+}
+
+unsafe fn from_wide_ptr(text: *const u16) -> String {
+    let mut len = 0;
+    while *text.add(len) != 0 {
+        len += 1;
+    }
+    String::from_utf16_lossy(std::slice::from_raw_parts(text, len))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn sddl_strings_are_the_approved_ones() {
+        assert_eq!(
+            process_sddl("S-1-5-21-1-2-3-1001"),
+            "D:P(A;;0x1FFFFF;;;SY)(A;;0x101000;;;S-1-5-21-1-2-3-1001)(A;;0x101000;;;OW)"
+        );
+        assert_eq!(
+            pipe_sddl("S-1-5-21-1-2-3-1001"),
+            "D:P(A;;GA;;;SY)(A;;GA;;;S-1-5-21-1-2-3-1001)"
+        );
+    }
+
+    #[test]
+    fn descriptors_build_for_the_current_user() {
+        let sid = current_user_sid().expect("user SID");
+        assert!(sid.starts_with("S-1-"));
+        process_descriptor().expect("process descriptor");
+        pipe_descriptor().expect("pipe descriptor");
+    }
+
+    #[test]
+    fn this_process_token_is_not_restricted() {
+        assert!(!process_token_is_restricted(std::process::id()));
+    }
+
+    #[test]
+    fn a_missing_process_counts_as_restricted() {
+        assert!(process_token_is_restricted(u32::MAX - 3));
+    }
+}
diff --git a/cli/src/windows_spawn.rs b/cli/src/windows_spawn.rs
new file mode 100644
index 0000000..84851c1
--- /dev/null
+++ b/cli/src/windows_spawn.rs
@@ -0,0 +1,485 @@
+//! Starting a child process that is protected from its first instruction.
+//!
+//! `std::process::Command` cannot pass a security descriptor to CreateProcess, so a child it
+//! starts runs, however briefly, with the default process DACL: a window in which any process
+//! of the same user can open it. `spawn_hardened` calls CreateProcessW itself with the
+//! protected descriptor (`windows_security::process_descriptor`) in lpProcessAttributes.
+//!
+//! It takes the program, arguments, environment changes and working directory from a
+//! configured `Command`, so call sites keep building their commands as before. Only the child's
+//! three stdio handles are inherited (PROC_THREAD_ATTRIBUTE_HANDLE_LIST), and only the child's
+//! ends of its pipes are ever inheritable.
+
+use std::ffi::{OsStr, OsString};
+use std::fs::File;
+use std::io;
+use std::mem;
+use std::os::windows::ffi::OsStrExt;
+use std::os::windows::io::{FromRawHandle, OwnedHandle};
+use std::os::windows::process::ExitStatusExt;
+use std::path::Path;
+use std::process::{Command, ExitStatus};
+use std::ptr;
+
+use windows_sys::Win32::Foundation::{
+    CloseHandle, SetHandleInformation, ERROR_ACCESS_DENIED, GENERIC_READ, GENERIC_WRITE, HANDLE,
+    HANDLE_FLAG_INHERIT, INVALID_HANDLE_VALUE, WAIT_OBJECT_0, WAIT_TIMEOUT,
+};
+use windows_sys::Win32::Security::SECURITY_ATTRIBUTES;
+use windows_sys::Win32::Storage::FileSystem::{
+    CreateFileW, FILE_SHARE_READ, FILE_SHARE_WRITE, OPEN_EXISTING,
+};
+use windows_sys::Win32::System::Pipes::CreatePipe;
+use windows_sys::Win32::System::Threading::{
+    CreateProcessW, DeleteProcThreadAttributeList, GetExitCodeProcess,
+    InitializeProcThreadAttributeList, TerminateProcess, UpdateProcThreadAttribute,
+    WaitForSingleObject, CREATE_UNICODE_ENVIRONMENT, EXTENDED_STARTUPINFO_PRESENT, INFINITE,
+    LPPROC_THREAD_ATTRIBUTE_LIST, PROCESS_INFORMATION, PROC_THREAD_ATTRIBUTE_HANDLE_LIST,
+    STARTF_USESTDHANDLES, STARTUPINFOEXW,
+};
+
+use crate::windows_security::{process_descriptor, raw, to_wide};
+
+/// What one of the child's stdio handles is connected to.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ChildStdio {
+    /// The NUL device.
+    Null,
+    /// A new anonymous pipe; the parent's end lands in `HardenedChild`.
+    Piped,
+}
+
+/// A running child started by `spawn_hardened`. Its fields and methods mirror the parts of
+/// `std::process::Child` that agent-browser uses.
+pub struct HardenedChild {
+    /// The handle CreateProcess returned. It has full access whatever the child's DACL says,
+    /// so waiting on and terminating the child keep working.
+    process: OwnedHandle,
+    pid: u32,
+    pub stdin: Option<File>,
+    pub stdout: Option<File>,
+    pub stderr: Option<File>,
+}
+
+impl HardenedChild {
+    pub fn id(&self) -> u32 {
+        self.pid
+    }
+
+    pub fn try_wait(&mut self) -> io::Result<Option<ExitStatus>> {
+        match unsafe { WaitForSingleObject(raw(&self.process), 0) } {
+            WAIT_OBJECT_0 => self.exit_status().map(Some),
+            WAIT_TIMEOUT => Ok(None),
+            _ => Err(io::Error::last_os_error()),
+        }
+    }
+
+    pub fn wait(&mut self) -> io::Result<ExitStatus> {
+        drop(self.stdin.take());
+        if unsafe { WaitForSingleObject(raw(&self.process), INFINITE) } != WAIT_OBJECT_0 {
+            return Err(io::Error::last_os_error());
+        }
+        self.exit_status()
+    }
+
+    pub fn kill(&mut self) -> io::Result<()> {
+        if unsafe { TerminateProcess(raw(&self.process), 1) } != 0 {
+            return Ok(());
+        }
+        let error = io::Error::last_os_error();
+        // As std does: a child that has already exited answers ERROR_ACCESS_DENIED.
+        if error.raw_os_error() == Some(ERROR_ACCESS_DENIED as i32) && self.try_wait()?.is_some() {
+            return Ok(());
+        }
+        Err(error)
+    }
+
+    fn exit_status(&self) -> io::Result<ExitStatus> {
+        let mut code = 0u32;
+        if unsafe { GetExitCodeProcess(raw(&self.process), &mut code) } == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(ExitStatus::from_raw(code))
+    }
+}
+
+/// Starts `command` with the protected process descriptor, the given stdio and the given
+/// creation flags. The program must be an absolute path (no PATH search happens here).
+pub fn spawn_hardened(
+    command: &Command,
+    stdio: [ChildStdio; 3],
+    creation_flags: u32,
+) -> io::Result<HardenedChild> {
+    let program = application_name(Path::new(command.get_program()))?;
+    let mut command_line = command_line(&program, command.get_args())?;
+    let program = wide_os(&program)?;
+    let environment = environment_block(command)?;
+    let current_dir = command
+        .get_current_dir()
+        .map(|d| wide_os(d.as_os_str()))
+        .transpose()?;
+
+    let mut child_ends = Vec::with_capacity(3);
+    let mut parent_ends = Vec::with_capacity(3);
+    for (index, kind) in stdio.into_iter().enumerate() {
+        let (child, parent) = match kind {
+            ChildStdio::Null => (open_nul()?, None),
+            ChildStdio::Piped => {
+                let (read, write) = anonymous_pipe()?;
+                // stdin: the child reads; stdout and stderr: the child writes.
+                if index == 0 {
+                    (read, Some(write))
+                } else {
+                    (write, Some(read))
+                }
+            }
+        };
+        set_inheritable(&child)?;
+        child_ends.push(child);
+        parent_ends.push(parent);
+    }
+    let inherited: Vec<HANDLE> = child_ends.iter().map(raw).collect();
+    let attributes = HandleList::new(&inherited)?;
+
+    let mut startup: STARTUPINFOEXW = unsafe { mem::zeroed() };
+    startup.StartupInfo.cb = mem::size_of::<STARTUPINFOEXW>() as u32;
+    startup.StartupInfo.dwFlags = STARTF_USESTDHANDLES;
+    startup.StartupInfo.hStdInput = inherited[0];
+    startup.StartupInfo.hStdOutput = inherited[1];
+    startup.StartupInfo.hStdError = inherited[2];
+    startup.lpAttributeList = attributes.as_ptr();
+
+    let descriptor = process_descriptor()?;
+    let process_attributes: SECURITY_ATTRIBUTES = descriptor.attributes();
+    let mut info: PROCESS_INFORMATION = unsafe { mem::zeroed() };
+    let ok = unsafe {
+        CreateProcessW(
+            program.as_ptr(),
+            command_line.as_mut_ptr(),
+            &process_attributes,
+            ptr::null(),
+            1,
+            creation_flags | EXTENDED_STARTUPINFO_PRESENT | CREATE_UNICODE_ENVIRONMENT,
+            environment.as_ptr().cast(),
+            current_dir.as_ref().map_or(ptr::null(), |d| d.as_ptr()),
+            &startup.StartupInfo,
+            &mut info,
+        )
+    };
+    if ok == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    unsafe { CloseHandle(info.hThread) };
+    drop(child_ends);
+
+    let mut parents = parent_ends.into_iter().map(|end| end.map(File::from));
+    Ok(HardenedChild {
+        process: unsafe { OwnedHandle::from_raw_handle(info.hProcess as _) },
+        pid: info.dwProcessId,
+        stdin: parents.next().flatten(),
+        stdout: parents.next().flatten(),
+        stderr: parents.next().flatten(),
+    })
+}
+
+/// The program path for lpApplicationName: absolute, and without a `\\?\` prefix on a plain
+/// drive path (which `canonicalize` adds).
+fn application_name(program: &Path) -> io::Result<OsString> {
+    if !program.is_absolute() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "spawn_hardened needs an absolute program path",
+        ));
+    }
+    let text = program.as_os_str().to_string_lossy();
+    if let Some(rest) = text.strip_prefix(r"\\?\") {
+        let drive = rest.as_bytes();
+        if drive.len() > 2 && drive[0].is_ascii_alphabetic() && drive[1] == b':' {
+            return Ok(OsString::from(rest));
+        }
+    }
+    Ok(program.as_os_str().to_owned())
+}
+
+/// The command line: the program in quotes, then each argument quoted as the MSVC runtime
+/// parses it (CommandLineToArgvW rules).
+pub(crate) fn command_line<'a>(
+    program: &OsStr,
+    args: impl Iterator<Item = &'a OsStr>,
+) -> io::Result<Vec<u16>> {
+    let mut line: Vec<u16> = Vec::new();
+    line.push(b'"' as u16);
+    line.extend(program.encode_wide());
+    line.push(b'"' as u16);
+    for arg in args {
+        line.push(b' ' as u16);
+        push_quoted(&mut line, arg);
+    }
+    if line.contains(&0) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "NUL in a command argument",
+        ));
+    }
+    line.push(0);
+    Ok(line)
+}
+
+fn push_quoted(line: &mut Vec<u16>, arg: &OsStr) {
+    let wide: Vec<u16> = arg.encode_wide().collect();
+    let special = |c: &u16| matches!(*c, 0x20 | 0x09 | 0x0A | 0x0B | 0x22);
+    if !wide.is_empty() && !wide.iter().any(special) {
+        line.extend(wide);
+        return;
+    }
+    line.push(b'"' as u16);
+    let mut backslashes = 0;
+    for c in wide {
+        if c == b'\\' as u16 {
+            backslashes += 1;
+        } else {
+            if c == b'"' as u16 {
+                // Double the backslashes before a quote and escape the quote itself.
+                line.extend(std::iter::repeat_n(b'\\' as u16, backslashes + 1));
+            }
+            backslashes = 0;
+        }
+        line.push(c);
+    }
+    // Double trailing backslashes so they do not escape the closing quote.
+    line.extend(std::iter::repeat_n(b'\\' as u16, backslashes));
+    line.push(b'"' as u16);
+}
+
+/// This process's environment with the command's changes applied, as a sorted
+/// CREATE_UNICODE_ENVIRONMENT block. Names compare case-insensitively, as Windows does.
+pub(crate) fn environment_block(command: &Command) -> io::Result<Vec<u16>> {
+    let key = |name: &OsStr| name.to_string_lossy().to_uppercase();
+    let mut vars: Vec<(OsString, OsString)> = std::env::vars_os().collect();
+    for (name, value) in command.get_envs() {
+        vars.retain(|(existing, _)| key(existing) != key(name));
+        if let Some(value) = value {
+            vars.push((name.to_owned(), value.to_owned()));
+        }
+    }
+    vars.sort_by_key(|(name, _)| key(name));
+
+    let mut block = Vec::new();
+    for (name, value) in vars {
+        let name: Vec<u16> = name.encode_wide().collect();
+        let value: Vec<u16> = value.encode_wide().collect();
+        if name.is_empty() || name.contains(&0) || value.contains(&0) || name[1..].contains(&0x3D) {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "bad environment variable",
+            ));
+        }
+        block.extend(name);
+        block.push(b'=' as u16);
+        block.extend(value);
+        block.push(0);
+    }
+    if block.is_empty() {
+        block.push(0);
+    }
+    block.push(0);
+    Ok(block)
+}
+
+fn wide_os(text: &OsStr) -> io::Result<Vec<u16>> {
+    let wide: Vec<u16> = text.encode_wide().collect();
+    if wide.contains(&0) {
+        return Err(io::Error::new(io::ErrorKind::InvalidInput, "NUL in a path"));
+    }
+    Ok(wide.into_iter().chain(std::iter::once(0)).collect())
+}
+
+fn open_nul() -> io::Result<OwnedHandle> {
+    let name = to_wide("NUL");
+    let handle = unsafe {
+        CreateFileW(
+            name.as_ptr(),
+            GENERIC_READ | GENERIC_WRITE,
+            FILE_SHARE_READ | FILE_SHARE_WRITE,
+            ptr::null(),
+            OPEN_EXISTING,
+            0,
+            0,
+        )
+    };
+    if handle == INVALID_HANDLE_VALUE {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(unsafe { OwnedHandle::from_raw_handle(handle as _) })
+}
+
+/// A pipe whose two ends are not inheritable; the caller makes the child's end inheritable.
+fn anonymous_pipe() -> io::Result<(OwnedHandle, OwnedHandle)> {
+    let mut read: HANDLE = 0;
+    let mut write: HANDLE = 0;
+    if unsafe { CreatePipe(&mut read, &mut write, ptr::null(), 0) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(unsafe {
+        (
+            OwnedHandle::from_raw_handle(read as _),
+            OwnedHandle::from_raw_handle(write as _),
+        )
+    })
+}
+
+fn set_inheritable(handle: &OwnedHandle) -> io::Result<()> {
+    if unsafe { SetHandleInformation(raw(handle), HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(())
+}
+
+/// A PROC_THREAD_ATTRIBUTE_LIST holding one PROC_THREAD_ATTRIBUTE_HANDLE_LIST. It points into
+/// `handles`, which must outlive it.
+struct HandleList {
+    buffer: Vec<usize>,
+}
+
+impl HandleList {
+    fn new(handles: &[HANDLE]) -> io::Result<Self> {
+        let mut size = 0usize;
+        unsafe { InitializeProcThreadAttributeList(ptr::null_mut(), 1, 0, &mut size) };
+        if size == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let mut list = Self {
+            buffer: vec![0usize; size.div_ceil(mem::size_of::<usize>())],
+        };
+        if unsafe { InitializeProcThreadAttributeList(list.as_ptr(), 1, 0, &mut size) } == 0 {
+            // Nothing to delete yet: forget the buffer's list before Drop sees it.
+            list.buffer.clear();
+            return Err(io::Error::last_os_error());
+        }
+        let ok = unsafe {
+            UpdateProcThreadAttribute(
+                list.as_ptr(),
+                0,
+                PROC_THREAD_ATTRIBUTE_HANDLE_LIST as usize,
+                handles.as_ptr().cast(),
+                mem::size_of_val(handles),
+                ptr::null_mut(),
+                ptr::null(),
+            )
+        };
+        if ok == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(list)
+    }
+
+    fn as_ptr(&self) -> LPPROC_THREAD_ATTRIBUTE_LIST {
+        self.buffer.as_ptr() as LPPROC_THREAD_ATTRIBUTE_LIST
+    }
+}
+
+impl Drop for HandleList {
+    fn drop(&mut self) {
+        if !self.buffer.is_empty() {
+            unsafe { DeleteProcThreadAttributeList(self.as_ptr()) };
+        }
+    }
+}
