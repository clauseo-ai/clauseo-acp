+
+    #[test]
+    fn a_hardened_child_cannot_be_opened_for_memory_reads_by_its_own_user() {
+        use windows_sys::Win32::System::Threading::{
+            OpenProcess, PROCESS_DUP_HANDLE, PROCESS_QUERY_LIMITED_INFORMATION, PROCESS_VM_READ,
+        };
+        let system = std::env::var("SystemRoot").unwrap_or_else(|_| r"C:\Windows".to_string());
+        let mut command = Command::new(format!(r"{system}\System32\ping.exe"));
+        command.args(["-n", "30", "127.0.0.1"]);
+        let mut child = spawn_hardened(
+            &command,
+            [ChildStdio::Null, ChildStdio::Null, ChildStdio::Null],
+            0,
+        )
+        .expect("spawn");
+        let open = |access| {
+            let handle = unsafe { OpenProcess(access, 0, child.id()) };
+            if handle != 0 {
+                unsafe { CloseHandle(handle) };
+            }
+            handle != 0
+        };
+        let limited = open(PROCESS_QUERY_LIMITED_INFORMATION);
+        let vm_read = open(PROCESS_VM_READ);
+        let dup_handle = open(PROCESS_DUP_HANDLE);
+        child.kill().unwrap();
+        child.wait().unwrap();
+        assert!(
+            limited,
+            "PROCESS_QUERY_LIMITED_INFORMATION should stay granted"
+        );
+        assert!(!vm_read, "PROCESS_VM_READ must be denied");
+        assert!(!dup_handle, "PROCESS_DUP_HANDLE must be denied");
+    }
+}
