+#[tokio::test(flavor = "multi_thread")]
+async fn the_client_refuses_a_daemon_of_another_session_or_key() {
+    // Two daemons in this process: session B's with this key, and this session's with another
+    // key. The client of this session, with this key, must refuse both.
+    let other_session = new_pipe_id().unwrap();
+    let other_keyed = new_pipe_id().unwrap();
+    let mut first = PipeListener::bind(&other_session, "another-session", key()).unwrap();
+    let mut second = PipeListener::bind(&other_keyed, SESSION, other_key()).unwrap();
+    let accept = tokio::spawn(async move {
+        loop {
+            tokio::select! {
+                a = first.accept() => if a.is_err() { break },
+                b = second.accept() => if b.is_err() { break },
+            }
+        }
+    });
+    let records = [this_process(&other_session), this_process(&other_keyed)];
+    let results = tokio::task::spawn_blocking(move || {
+        records
+            .map(|r| PipeStream::connect(&r, SESSION, &key(), Duration::from_secs(5)).map(|_| ()))
+    })
+    .await
+    .unwrap();
+    accept.abort();
+    for result in results {
+        let error = result.expect_err("a daemon of another session or key must be refused");
+        assert_eq!(error.kind(), io::ErrorKind::PermissionDenied);
+        assert!(error.to_string().contains("key"), "{error}");
+    }
