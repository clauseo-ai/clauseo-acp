+#[test]
+fn the_pipe_record_round_trips_and_only_a_keyed_record_is_read() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("s.pipe");
+    let record = this_process(&new_pipe_id().unwrap());
+    write_pipe_record(&path, &record, SESSION, &key()).unwrap();
+    assert_eq!(
+        read_pipe_record(&path, SESSION, &key()),
+        Some(record.clone())
+    );
+    // Another key or session: the record is not this session's.
+    assert_eq!(read_pipe_record(&path, SESSION, &other_key()), None);
+    assert_eq!(read_pipe_record(&path, "other", &key()), None);
+    let text = std::fs::read_to_string(&path).unwrap();
+    let mac = text.rsplit(' ').next().unwrap().to_string();
+    let fields = format!("{} {} {}", record.id, record.pid, record.created);
+    for bad in [
+        r"\\evil\pipe\x 1 2 00".to_string(),
+        record.id.clone(),
+        // A forged record without a MAC, or naming another live process with the old MAC.
+        fields.clone(),
+        format!("{} {} {} {mac}", record.id, record.pid + 4, record.created),
+        format!("{fields} {}", "0".repeat(64)),
+        format!("{fields} {mac} extra"),
+        format!("{} x {} {mac}", record.id, record.created),
+    ] {
+        std::fs::write(&path, &bad).unwrap();
+        assert_eq!(read_pipe_record(&path, SESSION, &key()), None, "{bad:?}");
+    }
+    assert!(!dir.path().join("s.pipe.partial").exists());
+}
