+#[cfg(windows)]
+#[test]
+fn dashboard_start_is_refused_on_windows() {
+    let tmp = TempDir::new().unwrap();
+    let output = run_dashboard(&tmp, &["dashboard", "start", "--json"]);
+    assert!(
+        !output.status.success(),
+        "the dashboard must not start on Windows"
+    );
+    let json = json_output(&output);
+    assert_eq!(json["success"], false);
+    assert!(json["error"]
+        .as_str()
+        .unwrap_or_default()
+        .contains("disabled on Windows"));
+    assert!(!socket_dir(&tmp).join("dashboard.pid").exists());
+}
