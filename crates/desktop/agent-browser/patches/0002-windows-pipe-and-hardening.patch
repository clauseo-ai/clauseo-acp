@@ -0,0 +1,501 @@
+//! The daemon's named pipe on Windows, which replaces loopback TCP.
+//!
+//! A loopback port can be reached by any local process, a sandboxed one included. The pipe is
+//! `\\.\pipe\clauseo-ab-<id>`, `<id>` being 128 random bits the daemon draws at start and
+//! writes to `<session>.pipe` in the socket directory with its own pid and creation time and a
+//! MAC with the session key (`session_key`); that file is the only way a client learns the name
+//! (never a command-line argument), and a record without a valid MAC is ignored. The name is
+//! no secret: any process can list pipes. What stands behind it:
+//!
+//! - the first instance is created with FILE_FLAG_FIRST_PIPE_INSTANCE, so the daemon fails
+//!   rather than join a pipe someone else created first;
+//! - every instance has a protected DACL for the user and SYSTEM only, and refuses remote
+//!   clients. Several instances listen at once, so a client holding one cannot make the pipe
+//!   busy for the others;
+//! - after a client connects, the daemon reads the client's process token and disconnects,
+//!   before writing a byte, unless it is unrestricted (anything that fails counts as
+//!   restricted);
+//! - the client checks that the pipe's server is the recorded daemon (pid and creation time, so
+//!   a reused pid fails), runs this executable and has an unrestricted token, and connects at
+//!   identification level only, so a pipe squatter cannot impersonate the client;
+//! - then both sides prove the session key (`session_key::client_handshake` and
+//!   `server_handshake`) before the first command: the daemon serves no client without the
+//!   key, and the client talks to no daemon of another session or key.
+
+use std::ffi::c_void;
+use std::io::{self, Read, Write};
+use std::mem;
+use std::os::windows::io::{AsRawHandle, FromRawHandle, OwnedHandle};
+use std::path::Path;
+use std::ptr;
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use tokio::net::windows::named_pipe::{NamedPipeServer, ServerOptions};
+use windows_sys::Win32::Foundation::{
+    GetLastError, ERROR_BROKEN_PIPE, ERROR_IO_PENDING, ERROR_PIPE_BUSY, ERROR_PIPE_NOT_CONNECTED,
+    GENERIC_READ, GENERIC_WRITE, HANDLE, INVALID_HANDLE_VALUE, WAIT_OBJECT_0, WAIT_TIMEOUT,
+};
+use windows_sys::Win32::Storage::FileSystem::{
+    CreateFileW, ReadFile, WriteFile, FILE_FLAG_OVERLAPPED, OPEN_EXISTING, SECURITY_IDENTIFICATION,
+    SECURITY_SQOS_PRESENT,
+};
+use windows_sys::Win32::System::Pipes::{
+    GetNamedPipeClientProcessId, GetNamedPipeServerProcessId, WaitNamedPipeW,
+};
+use windows_sys::Win32::System::Threading::{CreateEventW, WaitForSingleObject, INFINITE};
+use windows_sys::Win32::System::IO::{CancelIoEx, GetOverlappedResult, OVERLAPPED};
+
+use crate::session_key::{
+    client_handshake, record_mac, record_mac_matches, server_handshake, SessionKey,
+    HANDSHAKE_TIMEOUT,
+};
+use crate::windows_security::{
+    pipe_descriptor, process_creation_time, process_image, process_token_is_restricted, raw,
+    same_executable, to_wide, SecurityDescriptor,
+};
+
+/// How many instances of the pipe listen at once.
+const LISTENING_INSTANCES: usize = 4;
+
+/// Every daemon pipe's name starts with this.
+pub const PIPE_PREFIX: &str = r"\\.\pipe\clauseo-ab-";
+
+/// A fresh pipe id: 128 random bits as 32 lowercase hex characters.
+pub fn new_pipe_id() -> io::Result<String> {
+    let mut bytes = [0u8; 16];
+    getrandom::getrandom(&mut bytes).map_err(|e| io::Error::other(e.to_string()))?;
+    Ok(hex::encode(bytes))
+}
+
+/// Whether `id` is exactly what `new_pipe_id` makes. Anything else (a path, a server name) is
+/// refused before it can reach CreateFile.
+pub fn is_valid_pipe_id(id: &str) -> bool {
+    id.len() == 32 && id.bytes().all(|b| matches!(b, b'0'..=b'9' | b'a'..=b'f'))
+}
+
+pub fn pipe_path(id: &str) -> String {
+    format!("{PIPE_PREFIX}{id}")
+}
+
+/// What `<session>.pipe` holds: the pipe id, and the daemon serving it (pid and creation time),
+/// followed in the file by the record's MAC with the session key.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct PipeRecord {
+    pub id: String,
+    pub pid: u32,
+    pub created: u64,
+}
+
+impl PipeRecord {
+    /// The record for pipe `id` served by this process.
+    pub fn for_this_process(id: &str) -> io::Result<Self> {
+        let pid = std::process::id();
+        Ok(Self {
+            id: id.to_string(),
+            pid,
+            created: process_creation_time(pid)?,
+        })
+    }
+
+    /// `<id> <pid> <created>`, the part the MAC covers.
+    fn fields(&self) -> String {
+        format!("{} {} {}", self.id, self.pid, self.created)
+    }
+
+    /// `<id> <pid> <created> <mac>` with the MAC of `session` and `key`; anything else, or an id
+    /// `new_pipe_id` would not make, is None.
+    fn parse(text: &str, session: &str, key: &SessionKey) -> Option<Self> {
+        let mut parts = text.split_whitespace();
+        let (id, pid, created, mac) = (parts.next()?, parts.next()?, parts.next()?, parts.next()?);
+        if parts.next().is_some() || !is_valid_pipe_id(id) {
+            return None;
+        }
+        let record = Self {
+            id: id.to_string(),
+            pid: pid.parse().ok()?,
+            created: created.parse().ok()?,
+        };
+        record_mac_matches(key, session, &record.fields(), mac).then_some(record)
+    }
+}
+
+/// The record in a `<session>.pipe` file, if the file holds a valid one with the MAC of
+/// `session` and `key`.
+pub fn read_pipe_record(path: &Path, session: &str, key: &SessionKey) -> Option<PipeRecord> {
+    PipeRecord::parse(&std::fs::read_to_string(path).ok()?, session, key)
+}
+
+/// Writes `<session>.pipe` whole, with the record's MAC: a reader sees the old file, no file
+/// or the new record, never a part of it.
+pub fn write_pipe_record(
+    path: &Path,
+    record: &PipeRecord,
+    session: &str,
+    key: &SessionKey,
+) -> io::Result<()> {
+    let partial = path.with_extension("pipe.partial");
+    let fields = record.fields();
+    let text = format!("{fields} {}", record_mac(key, session, &fields));
+    std::fs::write(&partial, text)?;
+    std::fs::rename(&partial, path).inspect_err(|_| {
+        let _ = std::fs::remove_file(&partial);
+    })
+}
+
+/// The client's check of the pipe's server process: the daemon `record` names (same pid and
+/// creation time), running this executable, with an unrestricted token. Anything that cannot be
+/// checked refuses.
+pub fn check_server(server_pid: u32, record: &PipeRecord) -> io::Result<()> {
+    let refuse = |why: String| Err(io::Error::new(io::ErrorKind::PermissionDenied, why));
+    if server_pid != record.pid {
+        let daemon = record.pid;
+        return refuse(format!(
+            "the pipe's server is process {server_pid}, not the daemon {daemon}"
+        ));
+    }
+    if !process_creation_time(server_pid).is_ok_and(|t| t == record.created) {
+        return refuse(format!(
+            "process {server_pid} is not the process that started as the daemon"
+        ));
+    }
+    let ours = std::env::current_exe()?;
+    let image = process_image(server_pid).map(std::path::PathBuf::from);
+    if !image.is_ok_and(|image| same_executable(&image, &ours)) {
+        return refuse(format!("process {server_pid} does not run this executable"));
+    }
+    if process_token_is_restricted(server_pid) {
+        return refuse(format!("process {server_pid} runs with a restricted token"));
+    }
+    Ok(())
+}
+
+/// Opens the client end of pipe `id`, at identification level only. While every instance is
+/// busy it waits for a free one, for up to `busy_wait`.
+fn open(id: &str, busy_wait: Duration) -> io::Result<OwnedHandle> {
+    if !is_valid_pipe_id(id) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "invalid pipe id",
+        ));
+    }
+    let path = to_wide(&pipe_path(id));
+    let deadline = Instant::now() + busy_wait;
+    loop {
+        let handle = unsafe {
+            CreateFileW(
+                path.as_ptr(),
+                GENERIC_READ | GENERIC_WRITE,
+                0,
+                ptr::null(),
+                OPEN_EXISTING,
+                FILE_FLAG_OVERLAPPED | SECURITY_SQOS_PRESENT | SECURITY_IDENTIFICATION,
+                0,
+            )
+        };
+        if handle != INVALID_HANDLE_VALUE {
+            return Ok(unsafe { OwnedHandle::from_raw_handle(handle as _) });
+        }
+        let error = io::Error::last_os_error();
+        let left = deadline.saturating_duration_since(Instant::now());
+        if error.raw_os_error() != Some(ERROR_PIPE_BUSY as i32) || left.is_zero() {
+            return Err(error);
+        }
+        let ms = left.as_millis().clamp(1, u32::MAX as u128 - 1) as u32;
+        unsafe { WaitNamedPipeW(path.as_ptr(), ms) };
+    }
+}
+
+/// The client end: a blocking stream with optional read and write timeouts.
+pub struct PipeStream {
+    handle: OwnedHandle,
+    read_timeout: Option<Duration>,
+    write_timeout: Option<Duration>,
+}
+
+impl PipeStream {
+    /// Opens the pipe `record` names, checks its server (`check_server`) and runs the session
+    /// key exchange for `session` with `key`. While every instance is busy it waits for a
+    /// free one, for up to `busy_wait`.
+    pub fn connect(
+        record: &PipeRecord,
+        session: &str,
+        key: &SessionKey,
+        busy_wait: Duration,
+    ) -> io::Result<Self> {
+        let handle = open(&record.id, busy_wait)?;
+        let mut server_pid = 0u32;
+        if unsafe { GetNamedPipeServerProcessId(raw(&handle), &mut server_pid) } == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        check_server(server_pid, record)?;
+        let mut stream = Self {
+            handle,
+            read_timeout: Some(HANDSHAKE_TIMEOUT),
+            write_timeout: Some(HANDSHAKE_TIMEOUT),
+        };
+        client_handshake(&mut stream, key, session)?;
+        stream.read_timeout = None;
+        stream.write_timeout = None;
+        Ok(stream)
+    }
+
+    pub fn set_read_timeout(&mut self, timeout: Option<Duration>) {
+        self.read_timeout = timeout;
+    }
+
+    pub fn set_write_timeout(&mut self, timeout: Option<Duration>) {
+        self.write_timeout = timeout;
+    }
+
+    /// One overlapped read or write, waited on for at most `timeout`. A timed-out operation is
+    /// cancelled and reported as `TimedOut`; a read from a closed pipe returns 0 (EOF).
+    fn transfer(&self, data: *mut u8, len: usize, write: bool) -> io::Result<usize> {
+        let timeout = if write {
+            self.write_timeout
+        } else {
+            self.read_timeout
+        };
+        let len = len.min(u32::MAX as usize) as u32;
+        let event = unsafe { CreateEventW(ptr::null(), 1, 0, ptr::null()) };
+        if event == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let event = unsafe { OwnedHandle::from_raw_handle(event as _) };
+        let mut overlapped: OVERLAPPED = unsafe { mem::zeroed() };
+        overlapped.hEvent = raw(&event);
+        let handle = raw(&self.handle);
+
+        let started = unsafe {
+            if write {
+                WriteFile(handle, data, len, ptr::null_mut(), &mut overlapped)
+            } else {
+                ReadFile(handle, data, len, ptr::null_mut(), &mut overlapped)
+            }
+        };
+        if started == 0 {
+            let error = unsafe { GetLastError() };
+            if error != ERROR_IO_PENDING {
+                return end_of_pipe(error, write);
+            }
+        }
+
+        let ms = timeout.map_or(INFINITE, |t| t.as_millis().min(u32::MAX as u128 - 1) as u32);
+        let waited = unsafe { WaitForSingleObject(raw(&event), ms) };
+        let mut done = 0u32;
+        if waited == WAIT_TIMEOUT {
+            unsafe { CancelIoEx(handle, &overlapped) };
+            // Wait for the cancellation; the operation may have finished first.
+            if unsafe { GetOverlappedResult(handle, &overlapped, &mut done, 1) } != 0 {
+                return Ok(done as usize);
+            }
+            return Err(io::Error::new(
+                io::ErrorKind::TimedOut,
+                "pipe operation timed out",
+            ));
+        }
+        if waited != WAIT_OBJECT_0 {
+            let error = io::Error::last_os_error();
+            unsafe {
+                CancelIoEx(handle, &overlapped);
+                GetOverlappedResult(handle, &overlapped, &mut done, 1);
+            }
+            return Err(error);
+        }
+        if unsafe { GetOverlappedResult(handle, &overlapped, &mut done, 0) } == 0 {
+            return end_of_pipe(unsafe { GetLastError() }, write);
+        }
+        Ok(done as usize)
+    }
+}
+
+fn end_of_pipe(error: u32, write: bool) -> io::Result<usize> {
+    if !write && (error == ERROR_BROKEN_PIPE || error == ERROR_PIPE_NOT_CONNECTED) {
+        return Ok(0);
+    }
+    Err(io::Error::from_raw_os_error(error as i32))
+}
+
+impl Read for PipeStream {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        self.transfer(buf.as_mut_ptr(), buf.len(), false)
+    }
+}
+
+impl Write for PipeStream {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        // WriteFile only reads from the buffer.
+        self.transfer(buf.as_ptr() as *mut u8, buf.len(), true)
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+/// The daemon's end: `LISTENING_INSTANCES` instances wait for clients at once, each in its own
+/// task, so a client that holds one open (a read-only opener, say) cannot make the pipe busy.
+pub struct PipeListener {
+    accepted: tokio::sync::mpsc::Receiver<io::Result<NamedPipeServer>>,
+    slots: Vec<tokio::task::JoinHandle<()>>,
+}
+
+impl PipeListener {
+    /// Creates the pipe's instances, the first with FILE_FLAG_FIRST_PIPE_INSTANCE: fails if an
+    /// instance of that name exists already. Clients must prove `key` for `session`. Call it
+    /// inside a tokio runtime.
+    pub fn bind(id: &str, session: &str, key: SessionKey) -> io::Result<Self> {
+        if !is_valid_pipe_id(id) {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "invalid pipe id",
+            ));
+        }
+        let path = pipe_path(id);
+        let descriptor = Arc::new(pipe_descriptor()?);
+        let mut instances = vec![create_instance(&path, &descriptor, true)?];
+        for _ in 1..LISTENING_INSTANCES {
+            instances.push(create_instance(&path, &descriptor, false)?);
+        }
+        let (sender, accepted) = tokio::sync::mpsc::channel(LISTENING_INSTANCES);
+        let keyed = Arc::new((session.to_string(), key));
+        let slots = instances
+            .into_iter()
+            .map(|instance| {
+                let slot = serve_slot(
+                    instance,
+                    path.clone(),
+                    descriptor.clone(),
+                    keyed.clone(),
+                    sender.clone(),
+                );
+                tokio::spawn(slot)
+            })
+            .collect();
+        Ok(Self { accepted, slots })
+    }
+
+    /// The next client that passed the peer check and proved the session key. A client that
+    /// fails the peer check is disconnected before the daemon writes anything; one that fails
+    /// the key exchange has had only the daemon's challenge. Cancel safe.
+    pub async fn accept(&mut self) -> io::Result<NamedPipeServer> {
+        match self.accepted.recv().await {
+            Some(result) => result,
+            None => Err(io::Error::other("the pipe listener stopped")),
+        }
+    }
+}
+
+impl Drop for PipeListener {
+    /// Stops listening: every waiting instance closes with its task.
+    fn drop(&mut self) {
+        for slot in &self.slots {
+            slot.abort();
+        }
+    }
+}
+
+/// One listening slot: waits for a client, puts a fresh instance in its place, then runs the
+/// peer check and starts the key exchange (`authenticate`), which hands an accepted client to
+/// `accept`.
+async fn serve_slot(
+    mut instance: NamedPipeServer,
+    path: String,
+    descriptor: Arc<SecurityDescriptor>,
+    keyed: Arc<(String, SessionKey)>,
+    accepted: tokio::sync::mpsc::Sender<io::Result<NamedPipeServer>>,
+) {
+    loop {
+        let connected = instance.connect().await;
+        let fresh = loop {
+            match create_instance(&path, &descriptor, false) {
+                Ok(fresh) => break fresh,
+                Err(e) => {
+                    let _ = writeln!(io::stderr(), "Failed to create a pipe instance: {}", e);
+                    tokio::time::sleep(Duration::from_millis(100)).await;
+                }
+            }
+        };
+        let served = mem::replace(&mut instance, fresh);
+        let handed = match connected {
+            Err(e) => accepted.send(Err(e)).await,
+            Ok(()) => match client_refusal(&served) {
+                None => {
+                    // In a task of its own, so a client that stalls the exchange holds no slot.
+                    tokio::spawn(authenticate(served, keyed.clone(), accepted.clone()));
+                    Ok(())
+                }
+                Some(reason) => {
+                    let _ = writeln!(io::stderr(), "Refused a pipe client: {}", reason);
+                    let _ = served.disconnect();
+                    Ok(())
+                }
+            },
+        };
+        if handed.is_err() {
+            return; // the listener is gone
+        }
+    }
+}
+
+/// The daemon's side of the key exchange, for at most `HANDSHAKE_TIMEOUT`: hands the client to
+/// `accept` once it has proved the key, else disconnects it.
+async fn authenticate(
+    mut served: NamedPipeServer,
+    keyed: Arc<(String, SessionKey)>,
+    accepted: tokio::sync::mpsc::Sender<io::Result<NamedPipeServer>>,
+) {
+    let (session, key) = (&keyed.0, &keyed.1);
+    let exchange = server_handshake(&mut served, key, session);
+    match tokio::time::timeout(HANDSHAKE_TIMEOUT, exchange).await {
+        Ok(Ok(())) => {
+            let _ = accepted.send(Ok(served)).await;
+        }
+        outcome => {
+            let reason = match outcome {
+                Ok(Err(e)) => e.to_string(),
+                _ => "the session key exchange timed out".to_string(),
+            };
+            let _ = writeln!(io::stderr(), "Refused a pipe client: {}", reason);
+            let _ = served.disconnect();
+        }
+    }
+}
+
+fn create_instance(
+    path: &str,
+    descriptor: &SecurityDescriptor,
+    first: bool,
+) -> io::Result<NamedPipeServer> {
+    let mut attributes = descriptor.attributes();
+    unsafe {
+        ServerOptions::new()
+            .first_pipe_instance(first)
+            .reject_remote_clients(true)
+            .access_inbound(true)
+            .access_outbound(true)
+            .create_with_security_attributes_raw(path, &mut attributes as *mut _ as *mut c_void)
+    }
+}
+
+/// The peer check: None for a client whose process token is unrestricted, else why not.
+fn client_refusal(server: &NamedPipeServer) -> Option<String> {
+    let mut pid = 0u32;
+    let handle = server.as_raw_handle() as HANDLE;
+    if unsafe { GetNamedPipeClientProcessId(handle, &mut pid) } == 0 {
+        return Some(format!(
+            "no client process id ({})",
+            io::Error::last_os_error()
+        ));
+    }
+    if process_token_is_restricted(pid) {
+        return Some(format!(
+            "process {pid} has a restricted token, or it could not be read"
+        ));
+    }
+    None
+}
