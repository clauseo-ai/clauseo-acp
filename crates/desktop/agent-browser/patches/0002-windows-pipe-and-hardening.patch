+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io::Read;
+
+    fn quoted(arg: &str) -> String {
+        let mut line = Vec::new();
+        push_quoted(&mut line, OsStr::new(arg));
+        String::from_utf16(&line).unwrap()
+    }
+
+    #[test]
+    fn arguments_are_quoted_as_the_msvc_runtime_parses_them() {
+        assert_eq!(quoted("plain"), "plain");
+        assert_eq!(quoted(""), "\"\"");
+        assert_eq!(quoted("two words"), "\"two words\"");
+        assert_eq!(quoted("say \"hi\""), "\"say \\\"hi\\\"\"");
+        assert_eq!(quoted("C:\\dir with space\\"), "\"C:\\dir with space\\\\\"");
+        assert_eq!(quoted("a\\\\\"b"), "\"a\\\\\\\\\\\"b\"");
+        assert_eq!(quoted("no\\space"), "no\\space");
+    }
+
+    #[test]
+    fn verbatim_drive_paths_lose_their_prefix() {
+        let name = application_name(Path::new(r"\\?\C:\bin\agent-browser.exe")).unwrap();
+        assert_eq!(name, OsString::from(r"C:\bin\agent-browser.exe"));
+        assert!(application_name(Path::new("agent-browser.exe")).is_err());
+    }
+
+    #[test]
+    fn the_session_key_goes_only_into_the_block_of_a_hardened_child() {
+        let hex = "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff";
+        let session_key = crate::session_key::SessionKey::parse(hex).unwrap();
+        let entry = format!("{}={hex}", crate::session_key::ENV);
+        let mut command = Command::new("x");
+        command.env(crate::session_key::ENV, "from the command");
+        let with = String::from_utf16_lossy(
+            &environment_block_with(&command, Some(&session_key)).unwrap(),
+        );
+        assert!(
+            with.split('\0').any(|e| e == entry),
+            "the key replaces any other value"
+        );
+        let without = String::from_utf16_lossy(&environment_block(&Command::new("x")).unwrap());
+        assert!(!without.contains(hex));
+    }
+
+    #[test]
+    fn environment_changes_apply_case_insensitively() {
+        let mut command = Command::new(r"C:\x.exe");
+        command.env("AB_SPAWN_TEST_SET", "1").env_remove("PATH");
+        let block = environment_block(&command).unwrap();
+        let text = String::from_utf16(&block).unwrap();
+        assert!(text.contains("AB_SPAWN_TEST_SET=1\0"));
+        assert!(!text.to_uppercase().contains("\0PATH="));
+        assert!(text.ends_with("\0\0"));
+    }
+
+    #[test]
+    fn a_hardened_child_runs_and_reports_its_output_and_exit_code() {
+        let system = std::env::var("SystemRoot").unwrap_or_else(|_| r"C:\Windows".to_string());
+        let mut command = Command::new(format!(r"{system}\System32\cmd.exe"));
+        command.args(["/d", "/c", "echo hardened& exit 3"]);
+        let mut child = spawn_hardened(
+            &command,
+            [ChildStdio::Null, ChildStdio::Piped, ChildStdio::Null],
+            0,
+        )
+        .expect("spawn");
+        let mut out = String::new();
+        child
+            .stdout
+            .take()
+            .unwrap()
+            .read_to_string(&mut out)
+            .unwrap();
+        let status = child.wait().unwrap();
+        assert!(out.contains("hardened"), "stdout: {out:?}");
+        assert_eq!(status.code(), Some(3));
+    }
+
+    /// The variable that tells `vm_read_probe_child` which pid to probe.
+    const PROBE_PID: &str = "AB_SPAWN_PROBE_PID";
+
+    /// Run only as the probe of the test below (which sets PROBE_PID); a no-op otherwise. Prints
+    /// which rights it got on the pid, and its own token.
+    #[test]
+    fn vm_read_probe_child() {
+        use windows_sys::Win32::System::Threading::{
+            OpenProcess, PROCESS_DUP_HANDLE, PROCESS_QUERY_LIMITED_INFORMATION, PROCESS_VM_READ,
+        };
+        let Some(pid) = std::env::var(PROBE_PID)
+            .ok()
+            .and_then(|p| p.parse::<u32>().ok())
+        else {
+            return;
+        };
+        let open = |access| {
+            let handle = unsafe { OpenProcess(access, 0, pid) };
+            if handle != 0 {
+                unsafe { CloseHandle(handle) };
+            }
+            if handle != 0 {
+                "granted"
+            } else {
+                "denied"
+            }
+        };
+        println!(
+            "SPAWN-PROBE query={} vm_read={} dup_handle={}",
+            open(PROCESS_QUERY_LIMITED_INFORMATION),
+            open(PROCESS_VM_READ),
+            open(PROCESS_DUP_HANDLE)
+        );
+        println!(
+            "SPAWN-PROBE-TOKEN {}",
+            crate::windows_test_token::describe_own()
+        );
+    }
+
+    /// A same-user probe with a filtered, non-admin token without SeDebugPrivilege
+    /// (`windows_test_token::Kind::Filtered`) is denied PROCESS_VM_READ and PROCESS_DUP_HANDLE
+    /// on a hardened child, and keeps PROCESS_QUERY_LIMITED_INFORMATION. An elevated token with
+    /// SeDebugPrivilege (a CI runner's) opens any process whatever its DACL: not the threat.
+    #[test]
+    fn a_hardened_child_cannot_be_opened_for_memory_reads_by_its_own_user() {
+        use crate::windows_test_token::{Kind, Probe};
+        let system = std::env::var("SystemRoot").unwrap_or_else(|_| r"C:\Windows".to_string());
+        let mut command = Command::new(format!(r"{system}\System32\ping.exe"));
+        command.args(["-n", "60", "127.0.0.1"]);
+        let mut child = spawn_hardened(
+            &command,
+            [ChildStdio::Null, ChildStdio::Null, ChildStdio::Null],
+            0,
+        )
+        .expect("spawn");
+        let mut probe = Command::new(std::env::current_exe().unwrap());
+        probe
+            .args([
+                "--exact",
+                "windows_spawn::tests::vm_read_probe_child",
+                "--nocapture",
+                "--test-threads=1",
+                "-q",
+            ])
+            .env(PROBE_PID, child.id().to_string());
+        let probe = Probe::start(&probe, Kind::Filtered).expect("start the probe");
+        let token = probe.token.clone();
+        let (code, printed) = probe.finish(120_000);
+        child.kill().unwrap();
+        child.wait().unwrap();
+        let diagnosis = Probe::diagnosis(&token, Some(code), &printed);
+        let result = printed
+            .lines()
+            .find_map(|line| line.find("SPAWN-PROBE ").and_then(|at| line.get(at..)))
+            .unwrap_or_else(|| panic!("the probe printed no result{diagnosis}"));
+        assert!(
+            !token.contains("SeDebugPrivilege") && !token.contains("administrators enabled"),
+            "the probe's token is not filtered{diagnosis}"
+        );
+        assert!(
+            result.contains("query=granted"),
+            "PROCESS_QUERY_LIMITED_INFORMATION should stay granted{diagnosis}"
+        );
+        assert!(
+            result.contains("vm_read=denied"),
+            "PROCESS_VM_READ must be denied to a filtered same-user token{diagnosis}"
+        );
+        assert!(
+            result.contains("dup_handle=denied"),
+            "PROCESS_DUP_HANDLE must be denied to a filtered same-user token{diagnosis}"
+        );
+    }
+}
