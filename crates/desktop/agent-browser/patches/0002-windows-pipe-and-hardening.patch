+//! Windows process and pipe security.
+//!
+//! Every agent-browser process protects itself first thing in `main`: its DACL lets SYSTEM do
+//! anything, and lets the user (and OWNER RIGHTS, which caps the owner's implicit rights) only
+//! query limited information and wait on it. Another process of the same user, sandboxed or
+//! not, then cannot read its memory, duplicate its handles, inject a thread or change the DACL.
+//! The children agent-browser starts get the same descriptor at creation (`windows_spawn`), so
+//! they are protected from their first instruction.
+//!
+//! The daemon's named pipe gets a DACL for the user and SYSTEM only (`windows_pipe`), and the
+//! daemon refuses any client whose token is restricted, as a sandbox's is.
+
+use std::io;
+use std::os::windows::io::{FromRawHandle, OwnedHandle};
+use std::ptr;
+
+use windows_sys::Win32::Foundation::{
+    GetLastError, LocalFree, SetLastError, ERROR_INSUFFICIENT_BUFFER, ERROR_SUCCESS, FILETIME,
+    HANDLE, STILL_ACTIVE,
+};
+use windows_sys::Win32::Security::Authorization::{
+    ConvertSidToStringSidW, ConvertStringSecurityDescriptorToSecurityDescriptorW, SetSecurityInfo,
+    SDDL_REVISION_1, SE_KERNEL_OBJECT,
+};
+use windows_sys::Win32::Security::{
+    GetSecurityDescriptorDacl, GetTokenInformation, IsTokenRestricted, TokenUser, ACL,
+    DACL_SECURITY_INFORMATION, PROTECTED_DACL_SECURITY_INFORMATION, PSECURITY_DESCRIPTOR,
+    SECURITY_ATTRIBUTES, TOKEN_QUERY, TOKEN_USER,
+};
+use windows_sys::Win32::System::Threading::{
+    GetCurrentProcess, GetCurrentThread, GetExitCodeProcess, GetProcessTimes, OpenProcess,
+    OpenProcessToken, QueryFullProcessImageNameW, PROCESS_QUERY_LIMITED_INFORMATION,
+};
+
+/// The protected process DACL: SYSTEM gets PROCESS_ALL_ACCESS; the user and OWNER RIGHTS get
+/// PROCESS_QUERY_LIMITED_INFORMATION | SYNCHRONIZE (0x101000) and nothing else.
+pub fn process_sddl(user_sid: &str) -> String {
+    format!("D:P(A;;0x1FFFFF;;;SY)(A;;0x101000;;;{user_sid})(A;;0x101000;;;OW)")
+}
+
+/// The daemon pipe's protected DACL: full access for SYSTEM and the user, nobody else.
+pub fn pipe_sddl(user_sid: &str) -> String {
+    format!("D:P(A;;GA;;;SY)(A;;GA;;;{user_sid})")
+}
+
+/// A security descriptor built from SDDL, freed on drop.
+pub struct SecurityDescriptor(PSECURITY_DESCRIPTOR);
+
+// The descriptor is never changed after it is built, and LocalFree may run on any thread.
+unsafe impl Send for SecurityDescriptor {}
+unsafe impl Sync for SecurityDescriptor {}
+
+impl SecurityDescriptor {
+    pub fn from_sddl(sddl: &str) -> io::Result<Self> {
+        let wide = to_wide(sddl);
+        let mut descriptor: PSECURITY_DESCRIPTOR = ptr::null_mut();
+        let ok = unsafe {
+            ConvertStringSecurityDescriptorToSecurityDescriptorW(
+                wide.as_ptr(),
+                SDDL_REVISION_1,
+                &mut descriptor,
+                ptr::null_mut(),
+            )
+        };
+        if ok == 0 || descriptor.is_null() {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(Self(descriptor))
+    }
+
+    /// Non-inheritable SECURITY_ATTRIBUTES pointing at this descriptor. They borrow it: keep
+    /// the descriptor alive while the attributes are in use.
+    pub fn attributes(&self) -> SECURITY_ATTRIBUTES {
+        SECURITY_ATTRIBUTES {
+            nLength: std::mem::size_of::<SECURITY_ATTRIBUTES>() as u32,
+            lpSecurityDescriptor: self.0,
+            bInheritHandle: 0,
+        }
+    }
+
+    fn dacl(&self) -> io::Result<*mut ACL> {
+        let mut present = 0;
+        let mut defaulted = 0;
+        let mut dacl: *mut ACL = ptr::null_mut();
+        let ok =
+            unsafe { GetSecurityDescriptorDacl(self.0, &mut present, &mut dacl, &mut defaulted) };
+        if ok == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        if present == 0 || dacl.is_null() {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "descriptor has no DACL",
+            ));
+        }
+        Ok(dacl)
+    }
+}
+
+impl Drop for SecurityDescriptor {
+    fn drop(&mut self) {
+        unsafe { LocalFree(self.0) };
+    }
+}
+
+/// The descriptor every agent-browser process and child gets (`process_sddl`).
+pub fn process_descriptor() -> io::Result<SecurityDescriptor> {
+    SecurityDescriptor::from_sddl(&process_sddl(&current_user_sid()?))
+}
+
+/// The descriptor of the daemon's pipe (`pipe_sddl`).
+pub fn pipe_descriptor() -> io::Result<SecurityDescriptor> {
+    SecurityDescriptor::from_sddl(&pipe_sddl(&current_user_sid()?))
+}
+
+/// Replaces this process's DACL, and the calling thread's, with the protected one. Called first
+/// thing in `main`, on the main thread.
+pub fn harden_current_process() -> io::Result<()> {
+    let descriptor = process_descriptor()?;
+    set_dacl(unsafe { GetCurrentProcess() }, &descriptor)?;
+    set_dacl(unsafe { GetCurrentThread() }, &descriptor)
+}
+
+/// Gives the calling thread the protected DACL (for a thread, the user keeps SYNCHRONIZE and
+/// THREAD_RESUME, 0x101000: no GET_CONTEXT or SET_CONTEXT). Threads otherwise get the token's
+/// default DACL. That default is left alone on purpose: anonymous pipes (std's and
+/// CreatePipe's) take it and are reopened by name, so a protected default would break every
+/// piped child.
+pub fn harden_current_thread() -> io::Result<()> {
+    set_dacl(unsafe { GetCurrentThread() }, &process_descriptor()?)
+}
+
+/// `harden_current_thread` for a runtime's thread-start hook, which cannot return an error:
+/// a thread that cannot be protected ends the process (fail closed).
+pub fn harden_current_thread_or_abort() {
+    if let Err(e) = harden_current_thread() {
+        eprintln!("agent-browser: could not protect a thread: {}", e);
+        std::process::abort();
+    }
+}
+
+fn set_dacl(object: HANDLE, descriptor: &SecurityDescriptor) -> io::Result<()> {
+    let status = unsafe {
+        SetSecurityInfo(
+            object,
+            SE_KERNEL_OBJECT,
+            DACL_SECURITY_INFORMATION | PROTECTED_DACL_SECURITY_INFORMATION,
+            ptr::null_mut(),
+            ptr::null_mut(),
+            descriptor.dacl()?,
+            ptr::null(),
+        )
+    };
+    if status != ERROR_SUCCESS {
+        return Err(io::Error::from_raw_os_error(status as i32));
+    }
+    Ok(())
+}
+
+/// Process `pid`'s creation time (FILETIME ticks). With the pid it names one process: a pid
+/// can be reused, a (pid, creation time) pair cannot.
+pub fn process_creation_time(pid: u32) -> io::Result<u64> {
+    let process = open_limited(pid)?;
+    let mut times: [FILETIME; 4] = unsafe { std::mem::zeroed() };
+    let [created, exited, kernel, user] = &mut times;
+    if unsafe { GetProcessTimes(raw(&process), created, exited, kernel, user) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok((u64::from(created.dwHighDateTime) << 32) | u64::from(created.dwLowDateTime))
+}
+
+/// Whether process `pid` is running and was created at `created`.
+pub fn process_is_alive(pid: u32, created: u64) -> bool {
+    let Ok(process) = open_limited(pid) else {
+        return false;
+    };
+    let mut code = 0u32;
+    let running =
+        unsafe { GetExitCodeProcess(raw(&process), &mut code) } != 0 && code == STILL_ACTIVE as u32;
+    running && process_creation_time(pid).is_ok_and(|t| t == created)
+}
+
+/// The full path of process `pid`'s executable.
+pub fn process_image(pid: u32) -> io::Result<String> {
+    let process = open_limited(pid)?;
+    let mut buf = vec![0u16; 32_768];
+    let mut len = buf.len() as u32;
+    if unsafe { QueryFullProcessImageNameW(raw(&process), 0, buf.as_mut_ptr(), &mut len) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(String::from_utf16_lossy(&buf[..len as usize]))
+}
+
+/// Whether two executable paths name the same file: case-insensitive, `/` as `\`, and a
+/// `\\?\` prefix ignored.
+pub fn same_image(a: &str, b: &str) -> bool {
+    let plain = |p: &str| {
+        let p = p.replace('/', "\\");
+        p.strip_prefix(r"\\?\").unwrap_or(&p).to_lowercase()
+    };
+    plain(a) == plain(b)
+}
+
+fn open_limited(pid: u32) -> io::Result<OwnedHandle> {
+    let process = unsafe { OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, 0, pid) };
+    if process == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(unsafe { OwnedHandle::from_raw_handle(process as _) })
+}
+
+/// The user SID of this process's token, as `S-1-...`.
+pub fn current_user_sid() -> io::Result<String> {
+    let token = open_process_token(unsafe { GetCurrentProcess() })?;
+    let sid = token_user_sid(&token)?;
+    // The SID goes into SDDL: anything but a plain S-1-... string is refused.
+    let plain = sid.starts_with("S-1-")
+        && sid
+            .bytes()
+            .all(|b| b.is_ascii_digit() || b == b'-' || b == b'S');
+    if !plain {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "unexpected user SID",
+        ));
+    }
+    Ok(sid)
+}
+
+/// Whether process `pid` runs with a restricted token (one with restricting SIDs, as a sandbox's
+/// write-restricted token has). Fails closed: anything that cannot be checked counts as
+/// restricted.
+pub fn process_token_is_restricted(pid: u32) -> bool {
+    let Ok(process) = open_limited(pid) else {
+        return true;
+    };
+    let Ok(token) = open_process_token(raw(&process)) else {
+        return true;
+    };
+    unsafe {
+        SetLastError(0);
+        if IsTokenRestricted(raw(&token)) != 0 {
+            return true;
+        }
+        // Zero is both "not restricted" and a failure; only a clean zero passes.
+        GetLastError() != 0
+    }
+}
+
+fn open_process_token(process: HANDLE) -> io::Result<OwnedHandle> {
+    let mut token: HANDLE = 0;
+    if unsafe { OpenProcessToken(process, TOKEN_QUERY, &mut token) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(unsafe { OwnedHandle::from_raw_handle(token as _) })
+}
+
+fn token_user_sid(token: &OwnedHandle) -> io::Result<String> {
+    let mut len = 0u32;
+    unsafe { GetTokenInformation(raw(token), TokenUser, ptr::null_mut(), 0, &mut len) };
+    if len == 0 || unsafe { GetLastError() } != ERROR_INSUFFICIENT_BUFFER {
+        return Err(io::Error::last_os_error());
+    }
+    // u64s keep TOKEN_USER's pointer aligned.
+    let mut buf = vec![0u64; (len as usize).div_ceil(8)];
+    let ok = unsafe {
+        GetTokenInformation(
+            raw(token),
+            TokenUser,
+            buf.as_mut_ptr().cast(),
+            len,
+            &mut len,
+        )
+    };
+    if ok == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let user = unsafe { &*(buf.as_ptr() as *const TOKEN_USER) };
+    let mut text: *mut u16 = ptr::null_mut();
+    if unsafe { ConvertSidToStringSidW(user.User.Sid, &mut text) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let sid = unsafe { from_wide_ptr(text) };
+    unsafe { LocalFree(text.cast()) };
+    Ok(sid)
+}
+
+pub(crate) fn raw(handle: &OwnedHandle) -> HANDLE {
+    use std::os::windows::io::AsRawHandle;
+    handle.as_raw_handle() as HANDLE
+}
+
+pub(crate) fn to_wide(text: &str) -> Vec<u16> {
+    text.encode_utf16().chain(std::iter::once(0)).collect()
+}
+
+unsafe fn from_wide_ptr(text: *const u16) -> String {
+    let mut len = 0;
+    while *text.add(len) != 0 {
+        len += 1;
+    }
+    String::from_utf16_lossy(std::slice::from_raw_parts(text, len))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn sddl_strings_are_the_approved_ones() {
+        assert_eq!(
+            process_sddl("S-1-5-21-1-2-3-1001"),
+            "D:P(A;;0x1FFFFF;;;SY)(A;;0x101000;;;S-1-5-21-1-2-3-1001)(A;;0x101000;;;OW)"
+        );
+        assert_eq!(
+            pipe_sddl("S-1-5-21-1-2-3-1001"),
+            "D:P(A;;GA;;;SY)(A;;GA;;;S-1-5-21-1-2-3-1001)"
+        );
+    }
+
+    #[test]
+    fn descriptors_build_for_the_current_user() {
+        let sid = current_user_sid().expect("user SID");
+        assert!(sid.starts_with("S-1-"));
+        process_descriptor().expect("process descriptor");
+        pipe_descriptor().expect("pipe descriptor");
+    }
+
+    #[test]
+    fn this_process_token_is_not_restricted() {
+        assert!(!process_token_is_restricted(std::process::id()));
+    }
+
+    #[test]
+    fn a_missing_process_counts_as_restricted() {
+        assert!(process_token_is_restricted(u32::MAX - 3));
+    }
+}
