+//! Test-only: probe processes started under the tokens a sandbox gives, and the words a failed
+//! check prints about them. Two tokens, both made from this process's own:
+//!
+//! - `Kind::Filtered`: every privilege but SeChangeNotify deleted (DISABLE_MAX_PRIVILEGE, so no
+//!   SeDebugPrivilege, which opens any process whatever its DACL), BUILTIN\Administrators
+//!   deny-only, LUA_TOKEN. A same-user, non-admin probe, as Clauseo's browser guard tests probe
+//!   (crates/mcp, `job/harden_tests/probe.rs`). CI runners are elevated admins with
+//!   SeDebugPrivilege, which is outside the threat model.
+//! - `Kind::Restricted`: the filtered token, WRITE_RESTRICTED, with restricting SIDs, as Codex's
+//!   unelevated Windows sandbox makes one (its token.rs: restricting SIDs, then the logon SID and
+//!   Everyone). IsTokenRestricted is true for it. The logon SID is among the restricting SIDs so
+//!   the probe can open its window station and desktop: without it user32 fails to initialize
+//!   and the probe dies with STATUS_DLL_INIT_FAILED before running a line.
+
+use std::io::{self, Read};
+use std::mem;
+use std::os::windows::ffi::OsStrExt;
+use std::os::windows::io::{FromRawHandle, OwnedHandle};
+use std::process::Command;
+use std::ptr;
+use std::thread::JoinHandle;
+
+use windows_sys::Win32::Foundation::{
+    LocalFree, SetHandleInformation, HANDLE, HANDLE_FLAG_INHERIT, LUID, PSID, WAIT_OBJECT_0,
+};
+use windows_sys::Win32::Security::Authorization::ConvertSidToStringSidW;
+use windows_sys::Win32::Security::{
+    CreateRestrictedToken, CreateWellKnownSid, EqualSid, GetTokenInformation, IsTokenRestricted,
+    LookupPrivilegeNameW, TokenElevation, TokenGroups, TokenPrivileges, TokenUser,
+    WinBuiltinAdministratorsSid, WinWorldSid, DISABLE_MAX_PRIVILEGE, LUA_TOKEN,
+    LUID_AND_ATTRIBUTES, SECURITY_ATTRIBUTES, SE_PRIVILEGE_ENABLED, SID_AND_ATTRIBUTES,
+    TOKEN_ASSIGN_PRIMARY, TOKEN_DUPLICATE, TOKEN_ELEVATION, TOKEN_GROUPS, TOKEN_INFORMATION_CLASS,
+    TOKEN_PRIVILEGES, TOKEN_QUERY, TOKEN_USER, WRITE_RESTRICTED,
+};
+use windows_sys::Win32::System::Pipes::CreatePipe;
+use windows_sys::Win32::System::Threading::{
+    CreateProcessAsUserW, GetCurrentProcess, GetExitCodeProcess, OpenProcessToken,
+    TerminateProcess, WaitForSingleObject, CREATE_NO_WINDOW, CREATE_UNICODE_ENVIRONMENT,
+    PROCESS_INFORMATION, STARTF_USESTDHANDLES, STARTUPINFOW,
+};
+
+use crate::windows_security::raw;
+use crate::windows_spawn::{command_line, environment_block};
+
+/// `SE_GROUP_LOGON_ID`, `SE_GROUP_ENABLED` and `SE_GROUP_USE_FOR_DENY_ONLY`.
+const GROUP_LOGON_ID: u32 = 0xC000_0000;
+const GROUP_ENABLED: u32 = 0x4;
+const GROUP_DENY_ONLY: u32 = 0x10;
+/// The exit code of a process whose DLLs failed to initialize.
+pub const STATUS_DLL_INIT_FAILED: u32 = 0xC000_0142;
+
+/// Which token a probe runs under (see the module's header).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Kind {
+    Filtered,
+    Restricted,
+}
+
+/// This process's token, opened for `access`.
+fn own_token(access: u32) -> io::Result<OwnedHandle> {
+    let mut token: HANDLE = 0;
+    if unsafe { OpenProcessToken(GetCurrentProcess(), access, &mut token) } == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(unsafe { OwnedHandle::from_raw_handle(token as _) })
+}
+
+/// `class` of `token`, in an 8-aligned buffer.
+fn info(token: HANDLE, class: TOKEN_INFORMATION_CLASS) -> io::Result<Vec<u64>> {
+    let mut size = 0u32;
+    unsafe { GetTokenInformation(token, class, ptr::null_mut(), 0, &mut size) };
+    if size == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let mut buffer = vec![0u64; (size as usize).div_ceil(8)];
+    if unsafe { GetTokenInformation(token, class, buffer.as_mut_ptr().cast(), size, &mut size) }
+        == 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(buffer)
+}
+
+/// A well-known SID, in a buffer of SECURITY_MAX_SID_SIZE bytes.
+fn well_known(kind: i32) -> io::Result<Box<[u64; 9]>> {
+    let mut buffer = Box::new([0u64; 9]);
+    let mut size = mem::size_of::<[u64; 9]>() as u32;
+    if unsafe { CreateWellKnownSid(kind, ptr::null_mut(), buffer.as_mut_ptr().cast(), &mut size) }
+        == 0
+    {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(buffer)
+}
+
+/// The groups of `token`, as SID and attributes; the SIDs point into the returned buffer.
+fn groups(token: HANDLE) -> io::Result<(Vec<u64>, Vec<SID_AND_ATTRIBUTES>)> {
+    let buffer = info(token, TokenGroups)?;
+    let list = buffer.as_ptr().cast::<TOKEN_GROUPS>();
+    let count = unsafe { (*list).GroupCount } as usize;
+    let first = unsafe { ptr::addr_of!((*list).Groups).cast::<SID_AND_ATTRIBUTES>() };
+    let entries = (0..count).map(|i| unsafe { *first.add(i) }).collect();
+    Ok((buffer, entries))
+}
+
+/// A token of `kind` made from this process's own.
+pub fn token(kind: Kind) -> io::Result<OwnedHandle> {
+    let own = own_token(TOKEN_DUPLICATE | TOKEN_ASSIGN_PRIMARY | TOKEN_QUERY)?;
+    let mut admins = well_known(WinBuiltinAdministratorsSid)?;
+    let disable = [SID_AND_ATTRIBUTES {
+        Sid: admins.as_mut_ptr().cast(),
+        Attributes: 0,
+    }];
+    let mut everyone = well_known(WinWorldSid)?;
+    let user = info(raw(&own), TokenUser)?;
+    let user_sid = unsafe { (*user.as_ptr().cast::<TOKEN_USER>()).User.Sid };
+    let (_groups, entries) = groups(raw(&own))?;
+    let mut restricting = vec![
+        SID_AND_ATTRIBUTES {
+            Sid: user_sid,
+            Attributes: 0,
+        },
+        SID_AND_ATTRIBUTES {
+            Sid: everyone.as_mut_ptr().cast(),
+            Attributes: 0,
+        },
+    ];
+    if let Some(logon) = entries
+        .iter()
+        .find(|g| g.Attributes & GROUP_LOGON_ID == GROUP_LOGON_ID)
+    {
+        restricting.push(SID_AND_ATTRIBUTES {
+            Sid: logon.Sid,
+            Attributes: 0,
+        });
+    }
+    let (flags, count, sids) = match kind {
+        Kind::Filtered => (DISABLE_MAX_PRIVILEGE | LUA_TOKEN, 0, ptr::null()),
+        Kind::Restricted => (
+            DISABLE_MAX_PRIVILEGE | LUA_TOKEN | WRITE_RESTRICTED,
+            restricting.len() as u32,
+            restricting.as_ptr(),
+        ),
+    };
+    let mut made: HANDLE = 0;
+    let ok = unsafe {
+        CreateRestrictedToken(
+            raw(&own),
+            flags,
+            disable.len() as u32,
+            disable.as_ptr(),
+            0,
+            ptr::null(),
+            count,
+            sids,
+            &mut made,
+        )
+    };
+    if ok == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(unsafe { OwnedHandle::from_raw_handle(made as _) })
+}
+
+fn sid_string(sid: PSID) -> String {
+    let mut text: *mut u16 = ptr::null_mut();
+    if unsafe { ConvertSidToStringSidW(sid, &mut text) } == 0 {
+        return "(unreadable SID)".to_string();
+    }
+    let len = (0..).take_while(|&i| unsafe { *text.add(i) } != 0).count();
+    let string = String::from_utf16_lossy(unsafe { std::slice::from_raw_parts(text, len) });
+    unsafe { LocalFree(text as _) };
+    string
+}
+
+/// What a failed check prints about `token`: its user, elevation, whether it is restricted,
+/// BUILTIN\Administrators' state, the logon SID among its groups and its enabled privileges.
+pub fn describe(token: HANDLE) -> String {
+    let report = || -> io::Result<String> {
+        let user = info(token, TokenUser)?;
+        let user = sid_string(unsafe { (*user.as_ptr().cast::<TOKEN_USER>()).User.Sid });
+        let mut elevation = TOKEN_ELEVATION { TokenIsElevated: 0 };
+        let mut size = 0u32;
+        let elevated = (unsafe {
+            GetTokenInformation(
+                token,
+                TokenElevation,
+                ptr::addr_of_mut!(elevation).cast(),
+                mem::size_of::<TOKEN_ELEVATION>() as u32,
+                &mut size,
+            )
+        }) != 0
+            && elevation.TokenIsElevated != 0;
+        let restricted = unsafe { IsTokenRestricted(token) } != 0;
+        let mut admins = well_known(WinBuiltinAdministratorsSid)?;
+        let (_buffer, entries) = groups(token)?;
+        let admins = entries
+            .iter()
+            .find(|g| (unsafe { EqualSid(g.Sid, admins.as_mut_ptr().cast()) }) != 0)
+            .map_or("absent", |g| {
+                if g.Attributes & GROUP_DENY_ONLY != 0 {
+                    "deny-only"
+                } else if g.Attributes & GROUP_ENABLED != 0 {
+                    "enabled"
+                } else {
+                    "disabled"
+                }
+            });
+        let logon = entries
+            .iter()
+            .find(|g| g.Attributes & GROUP_LOGON_ID == GROUP_LOGON_ID)
+            .map_or("none".to_string(), |g| sid_string(g.Sid));
+        Ok(format!(
+            "user {user}, elevated {elevated}, restricted {restricted}, administrators {admins}, \
+             logon SID {logon}, privileges enabled {:?}",
+            enabled_privileges(token)?
+        ))
+    };
+    report().unwrap_or_else(|e| format!("(token unreadable: {e})"))
+}
+
+/// The names of the privileges enabled in `token`.
+pub fn enabled_privileges(token: HANDLE) -> io::Result<Vec<String>> {
+    let buffer = info(token, TokenPrivileges)?;
+    let list = buffer.as_ptr().cast::<TOKEN_PRIVILEGES>();
+    let count = unsafe { (*list).PrivilegeCount } as usize;
+    let first = unsafe { ptr::addr_of!((*list).Privileges).cast::<LUID_AND_ATTRIBUTES>() };
+    let mut names = Vec::new();
+    for i in 0..count {
+        let entry = unsafe { *first.add(i) };
+        if entry.Attributes & SE_PRIVILEGE_ENABLED == 0 {
+            continue;
+        }
+        let luid: LUID = entry.Luid;
+        let mut name = [0u16; 128];
+        let mut len = name.len() as u32;
+        if unsafe { LookupPrivilegeNameW(ptr::null(), &luid, name.as_mut_ptr(), &mut len) } != 0 {
+            names.push(String::from_utf16_lossy(&name[..len as usize]));
+        }
+    }
+    Ok(names)
+}
+
+/// This process's token, described.
+pub fn describe_own() -> String {
+    own_token(TOKEN_QUERY)
+        .map(|t| describe(raw(&t)))
+        .unwrap_or_else(|e| format!("(token unreadable: {e})"))
+}
+
+/// What an exit code says, for a failed check.
+pub fn exit_meaning(code: u32) -> String {
+    match code {
+        STATUS_DLL_INIT_FAILED => format!(
+            "{code:#x} STATUS_DLL_INIT_FAILED: the probe never ran (its token could not open \
+             the window station or desktop)"
+        ),
+        _ => format!("{code:#x}"),
+    }
+}
+
+/// A process started under a probe token, with its stdout and stderr going to one pipe.
+pub struct Probe {
+    pub process: OwnedHandle,
+    pub pid: u32,
+    /// The probe's token as made, for the failure text.
+    pub token: String,
+    output: JoinHandle<String>,
+}
+
+impl Probe {
+    /// Starts `command` (an absolute program) under a token of `kind`.
+    pub fn start(command: &Command, kind: Kind) -> io::Result<Probe> {
+        let token = token(kind)?;
+        let described = describe(raw(&token));
+        let program = command.get_program().to_owned();
+        let mut line = command_line(&program, command.get_args())?;
+        let app: Vec<u16> = program.encode_wide().chain(Some(0)).collect();
+        let environment = environment_block(command)?;
+
+        let mut read: HANDLE = 0;
+        let mut write: HANDLE = 0;
+        let inherit = SECURITY_ATTRIBUTES {
+            nLength: mem::size_of::<SECURITY_ATTRIBUTES>() as u32,
+            lpSecurityDescriptor: ptr::null_mut(),
+            bInheritHandle: 1,
+        };
+        if unsafe { CreatePipe(&mut read, &mut write, &inherit, 0) } == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let read = unsafe { OwnedHandle::from_raw_handle(read as _) };
+        let write = unsafe { OwnedHandle::from_raw_handle(write as _) };
+        unsafe { SetHandleInformation(raw(&read), HANDLE_FLAG_INHERIT, 0) };
+
+        let mut startup: STARTUPINFOW = unsafe { mem::zeroed() };
+        startup.cb = mem::size_of::<STARTUPINFOW>() as u32;
+        startup.dwFlags = STARTF_USESTDHANDLES;
+        startup.hStdOutput = raw(&write);
+        startup.hStdError = raw(&write);
+        let mut info: PROCESS_INFORMATION = unsafe { mem::zeroed() };
+        let ok = unsafe {
+            CreateProcessAsUserW(
+                raw(&token),
+                app.as_ptr(),
+                line.as_mut_ptr(),
+                ptr::null(),
+                ptr::null(),
+                1,
+                CREATE_NO_WINDOW | CREATE_UNICODE_ENVIRONMENT,
+                environment.as_ptr().cast(),
+                ptr::null(),
+                &startup,
+                &mut info,
+            )
+        };
+        if ok == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        drop(write);
+        unsafe { OwnedHandle::from_raw_handle(info.hThread as _) };
+        let mut reader = std::fs::File::from(read);
+        let output = std::thread::spawn(move || {
+            let mut bytes = Vec::new();
+            let _ = reader.read_to_end(&mut bytes);
+            String::from_utf8_lossy(&bytes).into_owned()
+        });
+        Ok(Probe {
+            process: unsafe { OwnedHandle::from_raw_handle(info.hProcess as _) },
+            pid: info.dwProcessId,
+            token: described,
+            output,
+        })
+    }
+
+    /// Whether the probe is still running.
+    pub fn running(&self) -> bool {
+        (unsafe { WaitForSingleObject(raw(&self.process), 0) }) != WAIT_OBJECT_0
+    }
+
+    /// Waits up to `ms` (ending it after that), and returns its exit code and all it printed.
+    pub fn finish(self, ms: u32) -> (u32, String) {
+        if unsafe { WaitForSingleObject(raw(&self.process), ms) } != WAIT_OBJECT_0 {
+            unsafe { TerminateProcess(raw(&self.process), 1) };
+            unsafe { WaitForSingleObject(raw(&self.process), ms) };
+        }
+        let mut code = 0u32;
+        unsafe { GetExitCodeProcess(raw(&self.process), &mut code) };
+        let printed = self.output.join().unwrap_or_default();
+        (code, printed)
+    }
+
+    /// What a failed check prints: the probe's token, the test's own, and `exit` and `printed`.
+    pub fn diagnosis(token: &str, exit: Option<u32>, printed: &str) -> String {
+        let exit = exit.map_or("still running".to_string(), exit_meaning);
+        format!(
+            "\n  probe's token: {token}\n  test's token: {}\n  probe's exit: {exit}\n  probe \
+             printed:\n{printed}",
+            describe_own()
+        )
+    }
+}
