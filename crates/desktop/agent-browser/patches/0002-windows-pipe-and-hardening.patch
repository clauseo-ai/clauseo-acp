@@ -0,0 +1,82 @@
+//! Commands for the programs agent-browser starts without its protected descriptor.
+//!
+//! On Windows such a child (Chrome, an engine, ffmpeg, a plugin, a probe like `where`) can be
+//! opened by any process of the user, a sandboxed one included, and its environment read. So
+//! there it starts with only the variables a Windows program needs to run: agent-browser's own
+//! settings, the CDP url among them, stay out of its memory. Elsewhere this is `Command::new`.
+
+use std::ffi::OsStr;
+use std::process::Command;
+
+/// The variables a child keeps on Windows.
+#[cfg(windows)]
+const BASE_ENV: &[&str] = &[
+    "ALLUSERSPROFILE",
+    "APPDATA",
+    "CommonProgramFiles",
+    "CommonProgramFiles(x86)",
+    "CommonProgramW6432",
+    "ComSpec",
+    "COMPUTERNAME",
+    "HOMEDRIVE",
+    "HOMEPATH",
+    "LOCALAPPDATA",
+    "NUMBER_OF_PROCESSORS",
+    "OS",
+    "PATH",
+    "PATHEXT",
+    "PROCESSOR_ARCHITECTURE",
+    "PROCESSOR_IDENTIFIER",
+    "ProgramData",
+    "ProgramFiles",
+    "ProgramFiles(x86)",
+    "ProgramW6432",
+    "PUBLIC",
+    "SystemDrive",
+    "SystemRoot",
+    "TEMP",
+    "TMP",
+    "USERDOMAIN",
+    "USERNAME",
+    "USERPROFILE",
+    "windir",
+];
+
+/// `Command::new(program)`, with the environment cut down to `BASE_ENV` on Windows. Variables a
+/// call site sets afterwards are kept.
+pub fn child_command(program: impl AsRef<OsStr>) -> Command {
+    #[allow(unused_mut)]
+    let mut command = Command::new(program);
+    #[cfg(windows)]
+    {
+        command.env_clear();
+        for name in BASE_ENV {
+            if let Some(value) = std::env::var_os(name) {
+                command.env(name, value);
+            }
+        }
+    }
+    command
+}
+
+#[cfg(all(test, windows))]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_child_keeps_only_the_base_variables() {
+        let _guard = crate::test_utils::EnvGuard::new(&["AGENT_BROWSER_CDP"]);
+        _guard.set(
+            "AGENT_BROWSER_CDP",
+            "ws://127.0.0.1:1/devtools/browser/secret",
+        );
+        let mut command = child_command("cmd.exe");
+        command.env("SET_BY_CALLER", "1");
+        let envs: Vec<_> = command.get_envs().collect();
+        assert!(envs
+            .iter()
+            .any(|(k, v)| *k == "SET_BY_CALLER" && v.is_some()));
+        assert!(envs.iter().all(|(k, _)| *k != "AGENT_BROWSER_CDP"));
+        assert!(envs.iter().any(|(k, _)| *k == "SystemRoot"));
+    }
+}
