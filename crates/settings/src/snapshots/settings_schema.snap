---
source: crates/settings/src/schema/tests.rs
---
{
  "$defs": {
    "AgentLaunch": {
      "description": "How to start one agent. `process` and `host` launch it; this crate only reads it.",
      "properties": {
        "args": {
          "default": [],
          "description": "Its arguments.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "description": "The program, as an absolute path.",
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Variables added to its environment. Never a secret: keys go in the OS keychain.",
          "type": "object"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    "BrowserSettings": {
      "description": "The `browser` section. Its key is a security key, set by policy only: a policy source that\ncannot be read locks it `false`, its default, and a `settings.json` value is ignored with a\nwarning.",
      "properties": {
        "allow_when_remote_debugging_disabled": {
          "default": false,
          "description": "Whether Clauseo's browser may start when the firm turned off Chrome's or Edge's remote\ndebugging (their `RemoteDebuggingAllowed` policy false), which every browser Clauseo\ndrives needs. Off by default: such a policy then turns Clauseo's browser off too.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Density": {
      "description": "How much space the app leaves round things.",
      "oneOf": [
        {
          "const": "comfortable",
          "description": "More space.",
          "type": "string"
        },
        {
          "const": "compact",
          "description": "Less space.",
          "type": "string"
        }
      ]
    },
    "FontSize": {
      "default": 16,
      "description": "A text size, in points.",
      "maximum": 20,
      "minimum": 14,
      "type": "integer"
    },
    "InstallSettings": {
      "description": "The `install` section: where agent installs come from in a firm. Both keys are security\nkeys: a policy source that cannot be read leaves both unset, so installs use the pinned\npublic hosts with their integrity checks.",
      "properties": {
        "bundle": {
          "default": null,
          "description": "An offline bundle folder, as an absolute path. Unset by default.",
          "type": [
            "string",
            "null"
          ]
        },
        "registry": {
          "default": null,
          "description": "A firm npm mirror: an `https` URL with a host, and no user name, password, query or\nfragment. Unset by default.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "KeychainRef": {
      "additionalProperties": false,
      "description": "A reference to a keychain item: `{\"keychain\": true}`. The item's account comes from the\nserver's name and the variable's or header's, so the reference names neither.",
      "properties": {
        "keychain": {
          "$ref": "#/$defs/Saved",
          "description": "Always `true`."
        }
      },
      "required": [
        "keychain"
      ],
      "type": "object"
    },
    "Language": {
      "description": "The app's language: one the app has words for.",
      "oneOf": [
        {
          "const": "en",
          "description": "English.",
          "type": "string"
        },
        {
          "const": "hi",
          "description": "Hindi.",
          "type": "string"
        }
      ]
    },
    "Lite": {
      "description": "Whether the app runs light: fewer effects, for slow machines.",
      "oneOf": [
        {
          "const": "automatic",
          "description": "The app decides from the machine.",
          "type": "string"
        },
        {
          "const": "on",
          "description": "Always light.",
          "type": "string"
        },
        {
          "const": "off",
          "description": "Never light.",
          "type": "string"
        }
      ]
    },
    "MattersSettings": {
      "description": "The `matters` section.",
      "properties": {
        "default_location": {
          "default": null,
          "description": "The folder new matters go in, as an absolute path. When absent: `Documents/Clauseo`, or,\nwith `CLAUSEO_DATA_DIR` set, `<data dir>-matters` beside the data folder.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "McpServerLaunch": {
      "anyOf": [
        {
          "description": "A program on this computer, speaking MCP on stdio.",
          "properties": {
            "args": {
              "default": [],
              "description": "Its arguments.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "command": {
              "description": "The program as the lawyer typed it: a bare name (`npx`), which the host finds on this\ncomputer's search paths at each launch, or an absolute path.",
              "type": "string"
            },
            "env": {
              "additionalProperties": {
                "$ref": "#/$defs/McpValue"
              },
              "default": {},
              "description": "Variables added to its environment, by name. A value is `{\"keychain\": true}`: it\nis in the OS keychain (service `ai.clauseo.desktop.mcp`, account\n`<server>/env/<name>`), where Settings › Tools puts every value the lawyer types.\nA plain string also works, for a firm's policy or a hand-edited file, but it is\nstored as it is in that file and sent to the agent in `session/new`: keep tokens in\nthe keychain.",
              "type": "object"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        },
        {
          "description": "A server at an `https` URL (`http` only for `localhost` or `127.0.0.1`). Stored and\nshown; this version sends it to no agent.",
          "properties": {
            "headers": {
              "additionalProperties": {
                "$ref": "#/$defs/McpValue"
              },
              "default": {},
              "description": "Headers sent with each request, by name: `{\"keychain\": true}` (account\n`<server>/header/<name>`) or a plain string, as for `env`.",
              "type": "object"
            },
            "url": {
              "description": "The URL.",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "type": "object"
        }
      ],
      "description": "One MCP server: a local program (`command`) or a remote URL (`url`), and whether it is on.\n`host` passes the enabled local ones to the agent in `session/new`. An entry with\n`command` is local (a `url` or `headers` beside it is ignored, with a warning); one with\n`url` and no `command` is remote.",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Whether the agent gets it. Off unless set.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "McpSettings": {
      "description": "The `mcp` section.",
      "properties": {
        "servers": {
          "additionalProperties": {
            "$ref": "#/$defs/McpServerLaunch"
          },
          "default": {},
          "description": "The MCP servers by name: 1 to 64 letters, digits, `_` or `-`, never holding `__` nor\nending in `_`; `browser`, `case-law`, `ide`, `claude-in-chrome` and `computer-use` are\nkept for Clauseo's and Claude Code's own. Each is off until it is turned on. A policy\nvalue replaces the whole list. Empty by default. Settings › Tools writes the lawyer's list\nhere, every value they type in the keychain.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "McpValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/KeychainRef",
          "description": "`{\"keychain\": true}`: the value is the keychain item of this server and name."
        },
        {
          "description": "The value itself, in plain text in the file it came from.",
          "type": "string"
        }
      ],
      "description": "An MCP server's variable or header value: in the keychain, or plain text in the file."
    },
    "Motion": {
      "description": "Whether the app animates.",
      "oneOf": [
        {
          "const": "system",
          "description": "As the OS's reduce-motion setting says.",
          "type": "string"
        },
        {
          "const": "reduce",
          "description": "Little or no animation.",
          "type": "string"
        },
        {
          "const": "full",
          "description": "Full animation.",
          "type": "string"
        }
      ]
    },
    "NetworkSettings": {
      "description": "The `network` section (decision records 0051, 0053). Every key is a security key: a policy\nsource that cannot be read leaves no proxy (so the OS's), no CA file, no added domain and no\nallowing a blocked site; block list updates stay on.",
      "properties": {
        "allow_unsafe_site_override": {
          "default": true,
          "description": "Whether the lawyer may allow a site the block list names (decision record 0053). On by\ndefault.",
          "type": "boolean"
        },
        "allowed_domains": {
          "default": [],
          "description": "Host names (`*.` before one allows the names under it) added to every matter's\nallowlist. Set by policy only; empty by default.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ca_certs": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "A CA file per agent id, as an absolute path, that the agent's network clients trust\nbesides the system's. Empty by default.",
          "type": "object"
        },
        "unsafe_site_list_updates": {
          "default": true,
          "description": "Whether the host fetches block list updates (decision record 0053). On by default; off,\nthe stored or bundled list stays in use and is never updated. Set by policy only. Locked\non, its default, when a policy source cannot be read: an unreadable policy must not stop\nprotection updates, so a firm that switched it off gets quiet failed fetches (on a\nnetwork that refuses them) while its policy source is unreadable.",
          "type": "boolean"
        },
        "upstream_proxy": {
          "default": null,
          "description": "The firm's proxy, which the egress proxy and agent installs send traffic through: an\n`http` or `https` URL with a host, and no user name, password, query or fragment. Unset\nby default: the proxy the OS is set to.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Plan": {
      "description": "One agent's firm plan (`plans.<id>`): a gateway or a cloud provider instead of the plan\nlogin. A security key: a policy source that cannot be read leaves no plan at all, so no\nendpoint the lawyer chose stands in for the firm's (decision record 0048).",
      "properties": {
        "endpoint": {
          "description": "The firm's gateway: an `https` URL with a host, and no user name, password, query or\nfragment.",
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra variables for the agent. A name holding `KEY`, `TOKEN`, `SECRET` or `PASSWORD`,\nin any case, is refused: secrets stay with IT's own tools and the OS keychain.",
          "type": "object"
        },
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanProvider"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whose service the plan uses."
        }
      },
      "type": "object"
    },
    "PlanProvider": {
      "description": "Whose service a firm plan uses.",
      "oneOf": [
        {
          "const": "anthropic",
          "description": "Anthropic's API, or a gateway that speaks it.",
          "type": "string"
        },
        {
          "const": "bedrock",
          "description": "Amazon Bedrock.",
          "type": "string"
        },
        {
          "const": "vertex",
          "description": "Google Vertex AI.",
          "type": "string"
        }
      ]
    },
    "PrivacySettings": {
      "description": "The `privacy` section: the anonymous usage counts and crash reports (decision record 0036).\nBoth keys are privacy keys: a policy can only turn them off. A policy `true` is ignored with a\nwarning and locks nothing; a policy `false`, a policy value that does not type, and a policy\nsource that cannot be read each lock the key `false`.",
      "properties": {
        "counts": {
          "default": true,
          "description": "Whether Clauseo keeps and sends its anonymous usage counts. On by default; nothing is\nkept or sent before the lawyer's first act.",
          "type": "boolean"
        },
        "crash_reports": {
          "default": false,
          "description": "Whether Clauseo sends crash reports. Off by default.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "SandboxSettings": {
      "description": "The `sandbox` section (decision record 0051). Both keys are security keys: a policy source\nthat cannot be read leaves `required` `false` and locks `allow_unprotected_auto` `false`, so\nan agent outside the sandbox runs only in the ask modes.",
      "properties": {
        "allow_unprotected_auto": {
          "default": true,
          "description": "Whether an agent outside the sandbox may still run in an auto mode; when off, it runs\nonly in the ask modes. On by default.",
          "type": "boolean"
        },
        "required": {
          "default": false,
          "description": "Whether the firm requires the sandbox: on a computer that cannot give it, no agent starts.\nOff by default.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Saved": {
      "const": true
    },
    "SkillsExtra": {
      "description": "Which packs beyond Clauseo's own may load.",
      "oneOf": [
        {
          "const": "off",
          "description": "None.",
          "type": "string"
        },
        {
          "const": "curated",
          "description": "Only those whose id is in `skills.curated`.",
          "type": "string"
        },
        {
          "const": "any",
          "description": "Any pack the lawyer turns on.",
          "type": "string"
        }
      ]
    },
    "SkillsSettings": {
      "description": "The `skills` section (decision record 0040). `extra`, `curated` and `allow_scripts` are\nsecurity keys: a policy source that cannot be read, or a policy value that does not type,\nlocks `extra` `off`, `allow_scripts` `false` and `curated` empty. `curated` is set by\npolicy only: a `settings.json` value is ignored with a warning.",
      "properties": {
        "allow_scripts": {
          "default": false,
          "description": "Whether a pack may carry scripts (copied, never run). Off by default.",
          "type": "boolean"
        },
        "curated": {
          "default": [],
          "description": "The pack ids `curated` admits. Set by policy only; empty by default.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "The packs turned on, by id, each with the hash it had then (`sha256:<64 lowercase hex>`):\na pack whose files no longer hash to it is not loaded. Empty by default.",
          "type": "object"
        },
        "extra": {
          "$ref": "#/$defs/SkillsExtra",
          "default": "off",
          "description": "Which packs beyond Clauseo's own may load. `off` by default."
        }
      },
      "type": "object"
    },
    "Theme": {
      "description": "The colour theme.",
      "oneOf": [
        {
          "const": "system",
          "description": "As the OS is set.",
          "type": "string"
        },
        {
          "const": "light",
          "description": "Light.",
          "type": "string"
        },
        {
          "const": "dark",
          "description": "Dark.",
          "type": "string"
        }
      ]
    },
    "ToolsSettings": {
      "description": "The `tools` section: Clauseo's own tools. Every key is a security key: a policy source that\ncannot be read, or a policy value that does not type, locks each `false`.",
      "properties": {
        "browser": {
          "default": "[per OS]",
          "description": "Whether the agent gets Clauseo's browser. On by default on macOS and Windows; off on\nLinux, which is for development and CI only.",
          "type": "boolean"
        },
        "connectors": {
          "default": true,
          "description": "Whether data connectors (R24's paid case-law connector) may run. On by default, but\nnothing runs until the lawyer adds a connector. A firm turns every connector off here.",
          "type": "boolean"
        },
        "web_search": {
          "default": true,
          "description": "Whether the agent may search the web and read web pages. On by default.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "UiSettings": {
      "description": "The `ui` section. Design may change these values before M4 without a decision record.",
      "properties": {
        "density": {
          "$ref": "#/$defs/Density",
          "default": "comfortable",
          "description": "How much space the app leaves round things."
        },
        "font_size": {
          "$ref": "#/$defs/FontSize",
          "default": 16,
          "description": "The text size, in points."
        },
        "language": {
          "$ref": "#/$defs/Language",
          "default": "en",
          "description": "The app's language."
        },
        "lite": {
          "$ref": "#/$defs/Lite",
          "default": "automatic",
          "description": "Whether the app drops its heavier effects, or decides from the machine."
        },
        "motion": {
          "$ref": "#/$defs/Motion",
          "default": "system",
          "description": "Whether the app animates, or follows the OS's reduce-motion setting."
        },
        "theme": {
          "$ref": "#/$defs/Theme",
          "default": "system",
          "description": "Light, dark, or as the OS is set."
        }
      },
      "type": "object"
    },
    "UpdateMode": {
      "description": "When Clauseo installs an update. The app writes only `auto` and `notify`; `none` comes from\npolicy, or a hand-edited `settings.json`.",
      "oneOf": [
        {
          "const": "auto",
          "description": "Download in the background, and install at the next start or when the lawyer says.",
          "type": "string"
        },
        {
          "const": "notify",
          "description": "Download, and install only when the lawyer says.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "Never check: the firm updates Clauseo itself.",
          "type": "string"
        }
      ]
    },
    "UpdateSettings": {
      "description": "The `update` section. `update.mode` is a security key: a policy may set any of its values,\nwhich locks it, and a policy source that cannot be read, or a policy value that does not\ntype, locks it `none`.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/UpdateMode",
          "default": "auto",
          "description": "When Clauseo installs an update. `auto` by default."
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Every setting, as `Effective::settings` gives it: the defaults, then `settings.json`, then\nthe policy layer.",
  "properties": {
    "agents": {
      "additionalProperties": {
        "$ref": "#/$defs/AgentLaunch"
      },
      "default": {},
      "description": "The agents Clauseo can launch, by id. Empty by default.",
      "type": "object"
    },
    "browser": {
      "$ref": "#/$defs/BrowserSettings",
      "default": {
        "allow_when_remote_debugging_disabled": false
      },
      "description": "What the firm allows Clauseo's browser beyond its browser policy."
    },
    "install": {
      "$ref": "#/$defs/InstallSettings",
      "default": {
        "bundle": null,
        "registry": null
      },
      "description": "Where agent installs come from in a firm (decision record 0048)."
    },
    "matters": {
      "$ref": "#/$defs/MattersSettings",
      "default": {
        "default_location": null
      },
      "description": "Where matters live."
    },
    "mcp": {
      "$ref": "#/$defs/McpSettings",
      "default": {
        "servers": {}
      },
      "description": "The MCP servers a lawyer can turn on for their agents' sessions."
    },
    "network": {
      "$ref": "#/$defs/NetworkSettings",
      "default": {
        "allow_unsafe_site_override": true,
        "allowed_domains": [],
        "ca_certs": {},
        "unsafe_site_list_updates": true,
        "upstream_proxy": null
      },
      "description": "The firm's network: its proxy, CA files and allowed domains (decision record 0051)."
    },
    "plans": {
      "additionalProperties": {
        "$ref": "#/$defs/Plan"
      },
      "default": {},
      "description": "Each agent's firm plan, by agent id (decision record 0048). Empty by default.",
      "type": "object"
    },
    "privacy": {
      "$ref": "#/$defs/PrivacySettings",
      "default": {
        "counts": true,
        "crash_reports": false
      },
      "description": "What Clauseo may count and send about its own use (decision record 0036)."
    },
    "sandbox": {
      "$ref": "#/$defs/SandboxSettings",
      "default": {
        "allow_unprotected_auto": true,
        "required": false
      },
      "description": "Whether the firm requires the agent sandbox, and what runs without it (decision record\n0051)."
    },
    "skills": {
      "$ref": "#/$defs/SkillsSettings",
      "default": {
        "allow_scripts": false,
        "curated": [],
        "enabled": {},
        "extra": "off"
      },
      "description": "The extra skill packs Clauseo may load (decision record 0040)."
    },
    "tools": {
      "$ref": "#/$defs/ToolsSettings",
      "default": {
        "browser": "[per OS]",
        "connectors": true,
        "web_search": true
      },
      "description": "Clauseo's own tools an agent may use. Read at start-up; a change applies after a restart."
    },
    "ui": {
      "$ref": "#/$defs/UiSettings",
      "default": {
        "density": "comfortable",
        "font_size": 16,
        "language": "en",
        "lite": "automatic",
        "motion": "system",
        "theme": "system"
      },
      "description": "How the app looks. The webview changes these only through a `UiPatch`."
    },
    "update": {
      "$ref": "#/$defs/UpdateSettings",
      "default": {
        "mode": "auto"
      },
      "description": "How Clauseo updates itself (task R23)."
    }
  },
  "title": "Settings",
  "type": "object"
}
