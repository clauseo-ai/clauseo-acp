{"scenario":"title-after-cancel","description":"The first prompt starts a tool call (no text), then is cancelled: session/cancel answers cancelled. The agent sends the session_info_update title 'Indemnity cap review' during turn two, before its answer. A turn with no answer text settles nothing, so the title is taken (D-070)","on_stdin_close":"exit"}
{"expect":{"method":"initialize","as":"init","params":{"protocolVersion":1}}}
{"respond":{"to":"init","result":{"protocolVersion":1,"agentCapabilities":{"loadSession":true},"authMethods":[],"agentInfo":{"name":"fake_agent","version":"0.0.0"}}}}
{"expect":{"method":"session/new","as":"new","params":{"cwd":"{{any}}"}}}
{"respond":{"to":"new","result":{"sessionId":"sess-1"}}}
{"expect":{"method":"session/prompt","as":"p1","params":{"sessionId":"sess-1"}}}
{"update":{"update":{"sessionUpdate":"tool_call","toolCallId":"tc-1","title":"Read brief.txt","kind":"read","status":"pending"}}}
{"expect":{"method":"session/cancel","params":{"sessionId":"sess-1"}}}
{"respond":{"to":"p1","result":{"stopReason":"cancelled"}}}
{"expect":{"method":"session/prompt","as":"p2","params":{"sessionId":"sess-1"}}}
{"update":{"update":{"sessionUpdate":"session_info_update","title":"Indemnity cap review"}}}
{"update":{"update":{"sessionUpdate":"agent_message_chunk","messageId":"m-answer-2","content":{"type":"text","text":"Second answer."}}}}
{"respond":{"to":"p2","result":{"stopReason":"end_turn"}}}
