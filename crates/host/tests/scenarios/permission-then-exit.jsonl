{"request":{"id":"perm-3","method":"session/request_permission","params":{"sessionId":"sess-1","toolCall":{"toolCallId":"tc-perm-3","title":"Edit clause 3","kind":"edit","status":"pending"},"options":[{"optionId":"allow-once","name":"Allow once","kind":"allow_once"},{"optionId":"reject-once","name":"Reject","kind":"reject_once"}]}}}
{"expect_response":{"id":"perm-3","result":{"outcome":{"outcome":"selected","optionId":"allow-once"}}}}
