{"scenario":"claude-auto-forced","description":"A claude-acp launch in forced ask (a network folder), jailed or not: session/new in default, so no set_mode; in the turn Claude moves itself to acceptEdits and the client must set it back to default","on_stdin_close":"exit"}
{"expect":{"method":"initialize","as":"init","params":{"protocolVersion":1}}}
{"respond":{"to":"init","result":{"protocolVersion":1,"agentCapabilities":{"loadSession":true},"authMethods":[],"agentInfo":{"name":"fake_agent","version":"0.0.0"}}}}
{"expect":{"method":"session/new","as":"new","params":{"cwd":"{{any}}","_meta":{"claudeCode":{"options":{"allowDangerouslySkipPermissions":false}}}}}}
{"respond":{"to":"new","result":{"sessionId":"sess-1","modes":{"currentModeId":"default","availableModes":[{"id":"default","name":"Manual"},{"id":"acceptEdits","name":"Accept edits"},{"id":"plan","name":"Plan"},{"id":"auto","name":"Auto"}]}}}}
{"expect":{"method":"session/prompt","as":"p1","params":{"sessionId":"sess-1"}}}
{"update":{"update":{"sessionUpdate":"current_mode_update","currentModeId":"acceptEdits"}}}
{"expect":{"method":"session/set_mode","as":"back","params":{"sessionId":"sess-1","modeId":"default"}}}
{"respond":{"to":"back","result":{}}}
{"update":{"update":{"sessionUpdate":"agent_message_chunk","messageId":"m-answer-1","content":{"type":"text","text":"Answer 1."}}}}
{"respond":{"to":"p1","result":{"stopReason":"end_turn"}}}
