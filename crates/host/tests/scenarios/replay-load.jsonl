{"scenario":"replay-load","description":"The second start after replay-seed: session/load of sess-1 replays the seeded turn (as load-replay does), then one more prompt","on_stdin_close":"exit"}
{"expect":{"method":"initialize","as":"init","params":{"protocolVersion":1}}}
{"respond":{"to":"init","result":{"protocolVersion":1,"agentCapabilities":{"loadSession":true},"authMethods":[],"agentInfo":{"name":"fake_agent","version":"0.0.0"}}}}
{"expect":{"method":"session/load","as":"load","params":{"sessionId":"sess-1","cwd":"{{any}}","mcpServers":[]}}}
