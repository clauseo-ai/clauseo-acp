{"update":{"update":{"sessionUpdate":"agent_thought_chunk","messageId":"m-thought-0","content":{"type":"text","text":"Reading clause 4 first."}}}}
{"update":{"update":{"sessionUpdate":"tool_call","toolCallId":"tc-edit-0","title":"Edit brief.txt","name":"Edit","kind":"edit","status":"completed","content":[{"type":"diff","path":"{{cwd}}/brief.txt","oldText":"Clause 4 draft\n","newText":"Clause 4 final\n"}],"locations":[{"path":"{{cwd}}/brief.txt"}]}}}
{"update":{"update":{"sessionUpdate":"agent_message_chunk","messageId":"m-answer-0","content":{"type":"text","text":"I changed clause 4 to the final wording."}}}}
{"respond":{"to":"load","result":{}}}
