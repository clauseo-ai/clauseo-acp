{"scenario":"web-late","description":"S26's late completion: a Claude web search left running; after session/cancel its completion arrives (Origin::Late) and records nothing; a second prompt ends end_turn","on_stdin_close":"exit"}
{"expect":{"method":"initialize","as":"init","params":{"protocolVersion":1}}}
{"respond":{"to":"init","result":{"protocolVersion":1,"agentCapabilities":{"loadSession":true},"authMethods":[],"agentInfo":{"name":"fake_agent","version":"0.0.0"}}}}
{"expect":{"method":"session/new","as":"new","params":{"cwd":"{{any}}"}}}
{"respond":{"to":"new","result":{"sessionId":"sess-1","modes":{"currentModeId":"default","availableModes":[{"id":"default","name":"Manual"},{"id":"acceptEdits","name":"Accept edits"},{"id":"plan","name":"Plan"},{"id":"auto","name":"Auto"}]}}}}
{"expect":{"method":"session/prompt","as":"p1","params":{"sessionId":"sess-1"}}}
{"update":{"update":{"sessionUpdate":"tool_call","toolCallId":"tc-late","title":"Fetch https://sci.gov.in/late","name":"WebFetch","kind":"fetch","status":"in_progress","rawInput":{"url":"https://sci.gov.in/late"}}}}
{"expect":{"method":"session/cancel","params":{"sessionId":"sess-1"}}}
{"update":{"update":{"sessionUpdate":"tool_call_update","toolCallId":"tc-late","status":"completed","content":[{"type":"content","content":{"type":"text","text":"Late page"}}]}}}
{"respond":{"to":"p1","result":{"stopReason":"cancelled"}}}
{"expect":{"method":"session/prompt","as":"p2","params":{"sessionId":"sess-1"}}}
{"update":{"update":{"sessionUpdate":"agent_message_chunk","messageId":"m-2","content":{"type":"text","text":"Second answer."}}}}
{"respond":{"to":"p2","result":{"stopReason":"end_turn"}}}
