{"scenario":"claude-mode-reset","description":"A claude-acp session outside forced ask, in auto: in the first turn the agent moves itself to bypassPermissions, in the second to dontAsk, after each of which the client must send set_mode auto; in the third to acceptEdits, which the client keeps","on_stdin_close":"exit"}
{"expect":{"method":"initialize","as":"init","params":{"protocolVersion":1}}}
{"respond":{"to":"init","result":{"protocolVersion":1,"agentCapabilities":{"loadSession":true},"authMethods":[],"agentInfo":{"name":"fake_agent","version":"0.0.0"}}}}
{"expect":{"method":"session/new","as":"new","params":{"cwd":"{{any}}","_meta":{"claudeCode":{"options":{"allowDangerouslySkipPermissions":false}}}}}}
{"respond":{"to":"new","result":{"sessionId":"sess-1","modes":{"currentModeId":"auto","availableModes":[{"id":"default","name":"Manual"},{"id":"acceptEdits","name":"Accept edits"},{"id":"plan","name":"Plan"},{"id":"auto","name":"Auto"}]}}}}
{"expect":{"method":"session/prompt","as":"p1","params":{"sessionId":"sess-1"}}}
{"update":{"update":{"sessionUpdate":"current_mode_update","currentModeId":"bypassPermissions"}}}
{"expect":{"method":"session/set_mode","as":"back-1","params":{"sessionId":"sess-1","modeId":"auto"}}}
{"respond":{"to":"back-1","result":{}}}
{"update":{"update":{"sessionUpdate":"agent_message_chunk","messageId":"m-answer-1","content":{"type":"text","text":"First answer."}}}}
{"respond":{"to":"p1","result":{"stopReason":"end_turn"}}}
{"expect":{"method":"session/prompt","as":"p2","params":{"sessionId":"sess-1"}}}
{"update":{"update":{"sessionUpdate":"current_mode_update","currentModeId":"dontAsk"}}}
{"expect":{"method":"session/set_mode","as":"back-2","params":{"sessionId":"sess-1","modeId":"auto"}}}
{"respond":{"to":"back-2","result":{}}}
{"update":{"update":{"sessionUpdate":"agent_message_chunk","messageId":"m-answer-2","content":{"type":"text","text":"Second answer."}}}}
{"respond":{"to":"p2","result":{"stopReason":"end_turn"}}}
{"expect":{"method":"session/prompt","as":"p3","params":{"sessionId":"sess-1"}}}
{"update":{"update":{"sessionUpdate":"current_mode_update","currentModeId":"acceptEdits"}}}
{"update":{"update":{"sessionUpdate":"agent_message_chunk","messageId":"m-answer-3","content":{"type":"text","text":"Third answer."}}}}
{"respond":{"to":"p3","result":{"stopReason":"end_turn"}}}
