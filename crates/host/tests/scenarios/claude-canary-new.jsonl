{"scenario":"claude-canary-new","description":"A claude-acp session/new whose flag settings carry the SessionStart settings canary (the step fails, exit 3, when they do not); the canary writes its nonce before the answer, which reports auto, so the prompt follows","on_stdin_close":"exit"}
{"expect":{"method":"initialize","as":"init","params":{"protocolVersion":1}}}
{"respond":{"to":"init","result":{"protocolVersion":1,"agentCapabilities":{"loadSession":true},"authMethods":[],"agentInfo":{"name":"fake_agent","version":"0.0.0"}}}}
{"expect":{"method":"session/new","as":"new","params":{"cwd":"{{any}}","_meta":{"claudeCode":{"options":{"settingSources":["user"]}}}}}}
{"note":"the SessionStart hook in the flag settings ran before the answer: the nonce is in its file","session_canary":"run"}
{"respond":{"to":"new","result":{"sessionId":"sess-1","modes":{"currentModeId":"auto","availableModes":[{"id":"default","name":"Manual"},{"id":"acceptEdits","name":"Accept edits"},{"id":"plan","name":"Plan"},{"id":"auto","name":"Auto"}]}}}}
{"expect":{"method":"session/prompt","as":"p1","params":{"sessionId":"sess-1"}}}
{"update":{"update":{"sessionUpdate":"agent_message_chunk","messageId":"m-p1","content":{"type":"text","text":"First answer."}}}}
{"respond":{"to":"p1","result":{"stopReason":"end_turn"}}}
