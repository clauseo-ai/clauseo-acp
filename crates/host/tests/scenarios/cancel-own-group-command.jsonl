{"scenario":"cancel-own-group-command","description":"At session/new, before answering, starts a child in a process group of its own (an MCP server's stand-in, mcp.pid); at the first prompt starts another (a command, cmd.pid) and streams a chunk; after session/cancel answers cancelled; a second prompt ends end_turn","on_stdin_close":"exit"}
{"expect":{"method":"initialize","as":"init","params":{"protocolVersion":1}}}
{"respond":{"to":"init","result":{"protocolVersion":1,"agentCapabilities":{"loadSession":true},"authMethods":[],"agentInfo":{"name":"fake_agent","version":"0.0.0"}}}}
{"expect":{"method":"session/new","as":"new","params":{"cwd":"{{any}}"}}}
{"spawn_child":{"pid_file":"mcp.pid","own_group":true}}
{"respond":{"to":"new","result":{"sessionId":"sess-1"}}}
{"expect":{"method":"session/prompt","as":"p1","params":{"sessionId":"sess-1"}}}
{"spawn_child":{"pid_file":"cmd.pid","own_group":true}}
{"update":{"update":{"sessionUpdate":"agent_message_chunk","messageId":"m-answer-1","content":{"type":"text","text":"Running the command."}}}}
{"expect":{"method":"session/cancel","params":{"sessionId":"sess-1"}}}
{"respond":{"to":"p1","result":{"stopReason":"cancelled"}}}
