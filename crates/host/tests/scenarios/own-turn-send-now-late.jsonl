{"scenario":"own-turn-send-now-late","description":"claude-agent-acp: prompt 1 ends, then the agent starts a turn of its own; a message sent now cancels it (session/cancel), after which the agent still sends a tool call that edits late.txt, text, and the cost-bearing usage_update that ends its turn; only then does prompt 2 come, which edits answer.txt","on_stdin_close":"exit"}
{"expect":{"method":"initialize","as":"init","params":{"protocolVersion":1}}}
{"respond":{"to":"init","result":{"protocolVersion":1,"agentCapabilities":{"loadSession":false,"_meta":{"claudeCode":{"promptQueueing":true}}},"authMethods":[],"agentInfo":{"name":"fake_agent","version":"0.0.0"},"_meta":{"steering":{"supported":true}}}}}
{"expect":{"method":"session/new","as":"new","params":{"cwd":"{{any}}","mcpServers":[]}}}
{"respond":{"to":"new","result":{"sessionId":"sess-1"}}}
{"expect":{"method":"session/prompt","as":"p1","params":{"sessionId":"sess-1"}}}
{"update":{"update":{"sessionUpdate":"agent_message_chunk","messageId":"m-answer-1","content":{"type":"text","text":"Done."}}}}
{"respond":{"to":"p1","result":{"stopReason":"end_turn"}}}
{"update":{"update":{"sessionUpdate":"tool_call","toolCallId":"tc-own-1","title":"Read build.log","kind":"read","status":"completed"}}}
{"update":{"update":{"sessionUpdate":"agent_message_chunk","messageId":"m-own-1","content":{"type":"text","text":"The build finished: 3 warnings."}}}}
{"expect":{"method":"session/cancel","params":{"sessionId":"sess-1"}}}
{"update":{"update":{"sessionUpdate":"tool_call","toolCallId":"tc-late-1","title":"Edit late.txt","kind":"edit","status":"in_progress"}}}
{"write_file":{"path":"late.txt","content":"A late edit.\n"}}
{"update":{"update":{"sessionUpdate":"tool_call_update","toolCallId":"tc-late-1","status":"completed"}}}
{"update":{"update":{"sessionUpdate":"agent_message_chunk","messageId":"m-own-1","content":{"type":"text","text":" Late words."}}}}
{"update":{"update":{"sessionUpdate":"usage_update","used":1520,"size":200000,"cost":{"amount":0.0123,"currency":"USD"}}}}
{"expect":{"method":"session/prompt","as":"p2","params":{"sessionId":"sess-1","prompt":[{"type":"text","text":"Read clause 9"}]}}}
{"update":{"update":{"sessionUpdate":"tool_call","toolCallId":"tc-p2-1","title":"Edit answer.txt","kind":"edit","status":"in_progress"}}}
{"write_file":{"path":"answer.txt","content":"Clause 9.\n"}}
{"update":{"update":{"sessionUpdate":"tool_call_update","toolCallId":"tc-p2-1","status":"completed"}}}
{"update":{"update":{"sessionUpdate":"agent_message_chunk","messageId":"m-answer-2","content":{"type":"text","text":"Clause 9 says."}}}}
{"respond":{"to":"p2","result":{"stopReason":"end_turn"}}}
