{"scenario":"claude-layout-load","description":"The start after an older layout moved (R17 PR-D1): a claude-acp session/load of sess-1 answered with modes in default, then one prompt","on_stdin_close":"exit"}
{"expect":{"method":"initialize","as":"init","params":{"protocolVersion":1}}}
{"respond":{"to":"init","result":{"protocolVersion":1,"agentCapabilities":{"loadSession":true},"authMethods":[],"agentInfo":{"name":"fake_agent","version":"0.0.0"}}}}
{"expect":{"method":"session/load","as":"load","params":{"sessionId":"sess-1","cwd":"{{any}}"}}}
{"respond":{"to":"load","result":{"modes":{"currentModeId":"default","availableModes":[{"id":"default","name":"Manual"},{"id":"acceptEdits","name":"Accept edits"},{"id":"plan","name":"Plan"}]}}}}
{"expect":{"method":"session/prompt","as":"p2","params":{"sessionId":"sess-1"}}}
{"update":{"update":{"sessionUpdate":"agent_message_chunk","messageId":"m-answer-2","content":{"type":"text","text":"Resumed."}}}}
{"respond":{"to":"p2","result":{"stopReason":"end_turn"}}}
