  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The body of `POST /v1/counts`.",
  "properties": {
    "days": {
      "description": "1 to 7 day reports, oldest first.",
      "items": {
        "$ref": "#/$defs/DayReport"
      },
      "type": "array"
    }
  },
  "required": [
    "days"
  ],
  "title": "Batch",
  "type": "object"
