---
source: crates/counts/src/schema/tests/wire.rs
expression: counts_schema()
---
{
  "$defs": {
    "Agent": {
      "description": "The lawyer's agent.",
      "oneOf": [
        {
          "const": "claude",
          "description": "Claude Code.",
          "type": "string"
        },
        {
          "const": "chatgpt",
          "description": "Codex, with a `ChatGPT` account or key.",
          "type": "string"
        }
      ]
    },
    "AnswerOutcome": {
      "description": "`answer_ended.outcome`.",
      "oneOf": [
        {
          "const": "done",
          "description": "The answer finished.",
          "type": "string"
        },
        {
          "const": "stopped_by_lawyer",
          "description": "The lawyer stopped it.",
          "type": "string"
        },
        {
          "const": "agent_stopped",
          "description": "The agent stopped.",
          "type": "string"
        },
        {
          "const": "limit",
          "description": "A plan limit stopped it.",
          "type": "string"
        },
        {
          "const": "signin_expired",
          "description": "The sign-in expired.",
          "type": "string"
        },
        {
          "const": "offline",
          "description": "The network went.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "Any other error.",
          "type": "string"
        }
      ]
    },
    "Arch": {
      "description": "The CPU architecture.",
      "oneOf": [
        {
          "const": "x86_64",
          "description": "Intel and AMD.",
          "type": "string"
        },
        {
          "const": "aarch64",
          "description": "Apple silicon and ARM64 Windows.",
          "type": "string"
        }
      ]
    },
    "Billing": {
      "description": "`sign_in.billing`.",
      "oneOf": [
        {
          "const": "plan",
          "description": "The agent vendor's plan.",
          "type": "string"
        },
        {
          "const": "api_key",
          "description": "An API key.",
          "type": "string"
        },
        {
          "const": "firm_address",
          "description": "The firm's own address.",
          "type": "string"
        }
      ]
    },
    "BreakKind": {
      "description": "`break_shown.kind`.",
      "oneOf": [
        {
          "const": "agent_stopped",
          "description": "The agent stopped.",
          "type": "string"
        },
        {
          "const": "signin_expired",
          "description": "The sign-in expired.",
          "type": "string"
        },
        {
          "const": "offline",
          "description": "No network.",
          "type": "string"
        },
        {
          "const": "terms_notice",
          "description": "A terms notice.",
          "type": "string"
        },
        {
          "const": "plan_shut_out",
          "description": "The plan shut the lawyer out.",
          "type": "string"
        }
      ]
    },
    "BreakThen": {
      "description": "`break_shown.then`.",
      "oneOf": [
        {
          "const": "restarted",
          "description": "Restarted.",
          "type": "string"
        },
        {
          "const": "signed_in",
          "description": "Signed in.",
          "type": "string"
        },
        {
          "const": "waited",
          "description": "Waited.",
          "type": "string"
        },
        {
          "const": "switched_agent",
          "description": "Switched agent.",
          "type": "string"
        },
        {
          "const": "left",
          "description": "Left.",
          "type": "string"
        }
      ]
    },
    "Cell_AgentInstall": {
      "additionalProperties": false,
      "description": "`agent_install`: each download ends.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/Agent",
          "description": "The agent."
        },
        "n": {
          "$ref": "#/$defs/Count"
        },
        "result": {
          "$ref": "#/$defs/InstallResult",
          "description": "How it ended."
        },
        "took": {
          "$ref": "#/$defs/Took",
          "description": "How long it took."
        },
        "tries": {
          "$ref": "#/$defs/Tries",
          "description": "How many tries it took."
        }
      },
      "required": [
        "agent",
        "result",
        "tries",
        "took",
        "n"
      ],
      "type": "object"
    },
    "Cell_AnswerEnded": {
      "additionalProperties": false,
      "description": "`answer_ended`: an answer ends.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/Agent",
          "description": "The agent."
        },
        "first_words": {
          "anyOf": [
            {
              "$ref": "#/$defs/Took"
            },
            {
              "type": "null"
            }
          ],
          "description": "How long until the first words; left out when none came."
        },
        "n": {
          "$ref": "#/$defs/Count"
        },
        "outcome": {
          "$ref": "#/$defs/AnswerOutcome",
          "description": "How it ended."
        },
        "took": {
          "$ref": "#/$defs/Took",
          "description": "How long the whole answer took."
        }
      },
      "required": [
        "agent",
        "outcome",
        "took",
        "n"
      ],
      "type": "object"
    },
    "Cell_AppOpened": {
      "additionalProperties": false,
      "description": "`app_opened`: each start.",
      "properties": {
        "launch": {
          "$ref": "#/$defs/Launch",
          "description": "A plain start or the first after an update."
        },
        "n": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "launch",
        "n"
      ],
      "type": "object"
    },
    "Cell_BreakShown": {
      "additionalProperties": false,
      "description": "`break_shown`: one of Item 16's screens.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/BreakKind",
          "description": "Which break."
        },
        "n": {
          "$ref": "#/$defs/Count"
        },
        "then": {
          "$ref": "#/$defs/BreakThen",
          "description": "What the lawyer did next."
        }
      },
      "required": [
        "kind",
        "then",
        "n"
      ],
      "type": "object"
    },
    "Cell_ErrorShown": {
      "additionalProperties": false,
      "description": "`error_shown`: the UI shows an error's copy.",
      "properties": {
        "code": {
          "$ref": "#/$defs/StrictErrorCode",
          "description": "The code, never `unknown`."
        },
        "n": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "code",
        "n"
      ],
      "type": "object"
    },
    "Cell_FeatureUsed": {
      "additionalProperties": false,
      "description": "`feature_used`: each use.",
      "properties": {
        "feature": {
          "$ref": "#/$defs/Feature",
          "description": "The feature."
        },
        "n": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "feature",
        "n"
      ],
      "type": "object"
    },
    "Cell_FirstRead": {
      "additionalProperties": false,
      "description": "`first_read`: a first read ends.",
      "properties": {
        "n": {
          "$ref": "#/$defs/Count"
        },
        "papers": {
          "$ref": "#/$defs/Papers",
          "description": "How many papers, as a bucket."
        },
        "result": {
          "$ref": "#/$defs/FirstReadResult",
          "description": "How it ended."
        },
        "took": {
          "$ref": "#/$defs/Took",
          "description": "How long it took."
        }
      },
      "required": [
        "result",
        "papers",
        "took",
        "n"
      ],
      "type": "object"
    },
    "Cell_Limit": {
      "additionalProperties": false,
      "description": "`limit`: the limits crate reports it.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/Agent",
          "description": "The agent."
        },
        "kind": {
          "$ref": "#/$defs/LimitKind",
          "description": "What happened."
        },
        "n": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "agent",
        "kind",
        "n"
      ],
      "type": "object"
    },
    "Cell_MatterOpened": {
      "additionalProperties": false,
      "description": "`matter_opened`: a matter opens.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/MatterKind",
          "description": "An existing folder, a new one or the sample."
        },
        "n": {
          "$ref": "#/$defs/Count"
        },
        "papers": {
          "$ref": "#/$defs/Papers",
          "description": "How many papers, as a bucket."
        },
        "place": {
          "anyOf": [
            {
              "$ref": "#/$defs/Place"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where the folder is; left out until stage D's `matters::place` exists."
        },
        "protection": {
          "$ref": "#/$defs/Protection",
          "description": "Whether the sandbox runs."
        }
      },
      "required": [
        "kind",
        "papers",
        "protection",
        "n"
      ],
      "type": "object"
    },
    "Cell_Onboarding": {
      "additionalProperties": false,
      "description": "`onboarding_step`: once per step per install.",
      "properties": {
        "n": {
          "$ref": "#/$defs/Count"
        },
        "step": {
          "$ref": "#/$defs/OnboardingStep",
          "description": "The step."
        }
      },
      "required": [
        "step",
        "n"
      ],
      "type": "object"
    },
    "Cell_PermissionAsked": {
      "additionalProperties": false,
      "description": "`permission_asked`: an escalation is answered.",
      "properties": {
        "answer": {
          "$ref": "#/$defs/PermissionAnswer",
          "description": "The answer."
        },
        "kind": {
          "$ref": "#/$defs/PermissionKind",
          "description": "What was asked."
        },
        "n": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "kind",
        "answer",
        "n"
      ],
      "type": "object"
    },
    "Cell_QuestionSent": {
      "additionalProperties": false,
      "description": "`question_sent`: the lawyer sends.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/Agent",
          "description": "The agent."
        },
        "delivery": {
          "$ref": "#/$defs/Delivery",
          "description": "How it went."
        },
        "n": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "agent",
        "delivery",
        "n"
      ],
      "type": "object"
    },
    "Cell_SettingChanged": {
      "description": "`setting_changed`: a setting changed, with its new value in that setting's own enum.\nSettings with free values (the matters folder, keys, addresses) have no variant.\n`preparing_ahead` and `keep_versions` wait for their settings to exist (a new variant is\nadded before the release that sends it, as for error codes).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "`ui.language`.",
          "properties": {
            "n": {
              "$ref": "#/$defs/Count"
            },
            "setting": {
              "const": "language",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Language"
            }
          },
          "required": [
            "setting",
            "value",
            "n"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`ui.theme`.",
          "properties": {
            "n": {
              "$ref": "#/$defs/Count"
            },
            "setting": {
              "const": "theme",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Theme"
            }
          },
          "required": [
            "setting",
            "value",
            "n"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`ui.font_size`.",
          "properties": {
            "n": {
              "$ref": "#/$defs/Count"
            },
            "setting": {
              "const": "text_size",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/TextSize"
            }
          },
          "required": [
            "setting",
            "value",
            "n"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`ui.lite`.",
          "properties": {
            "n": {
              "$ref": "#/$defs/Count"
            },
            "setting": {
              "const": "lite_mode",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/LiteMode"
            }
          },
          "required": [
            "setting",
            "value",
            "n"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`ui.motion`.",
          "properties": {
            "n": {
              "$ref": "#/$defs/Count"
            },
            "setting": {
              "const": "reduced_motion",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/ReducedMotion"
            }
          },
          "required": [
            "setting",
            "value",
            "n"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`update.mode` (R23).",
          "properties": {
            "n": {
              "$ref": "#/$defs/Count"
            },
            "setting": {
              "const": "update_mode",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/UpdateMode"
            }
          },
          "required": [
            "setting",
            "value",
            "n"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`privacy.crash_reports` (S22). Counts' own switch is never counted: off sends nothing.",
          "properties": {
            "n": {
              "$ref": "#/$defs/Count"
            },
            "setting": {
              "const": "crash_reports",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "setting",
            "value",
            "n"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The default agent.",
          "properties": {
            "n": {
              "$ref": "#/$defs/Count"
            },
            "setting": {
              "const": "default_agent",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Agent"
            }
          },
          "required": [
            "setting",
            "value",
            "n"
          ],
          "type": "object"
        }
      ]
    },
    "Cell_SignIn": {
      "additionalProperties": false,
      "description": "`sign_in`: each sign-in run ends.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/Agent",
          "description": "The agent."
        },
        "billing": {
          "$ref": "#/$defs/Billing",
          "description": "How the lawyer pays."
        },
        "n": {
          "$ref": "#/$defs/Count"
        },
        "result": {
          "$ref": "#/$defs/SignInResult",
          "description": "How it ended."
        }
      },
      "required": [
        "agent",
        "billing",
        "result",
        "n"
      ],
      "type": "object"
    },
    "Cell_Stall": {
      "additionalProperties": false,
      "description": "`stall`: the hang monitor fires.",
      "properties": {
        "n": {
          "$ref": "#/$defs/Count"
        },
        "took": {
          "$ref": "#/$defs/StallTook",
          "description": "How long."
        },
        "where": {
          "$ref": "#/$defs/StallWhere",
          "description": "Which side hung."
        }
      },
      "required": [
        "where",
        "took",
        "n"
      ],
      "type": "object"
    },
    "Cell_TimeOpen": {
      "additionalProperties": false,
      "description": "`time_open`: one cell a day, made at the day's close from the foreground time. Not an\n[`Event`]: `Counts` adds the foreground time up itself.",
      "properties": {
        "bucket": {
          "$ref": "#/$defs/TimeOpenBucket",
          "description": "The day's foreground time."
        },
        "n": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "bucket",
        "n"
      ],
      "type": "object"
    },
    "Cell_Update": {
      "additionalProperties": false,
      "description": "`update`: the updater ends a run.",
      "properties": {
        "n": {
          "$ref": "#/$defs/Count"
        },
        "result": {
          "$ref": "#/$defs/UpdateResult",
          "description": "How it ended."
        }
      },
      "required": [
        "result",
        "n"
      ],
      "type": "object"
    },
    "Channel": {
      "description": "The release channel, a build constant.",
      "oneOf": [
        {
          "const": "stable",
          "description": "Released builds.",
          "type": "string"
        },
        {
          "const": "beta",
          "description": "Beta builds.",
          "type": "string"
        }
      ]
    },
    "Count": {
      "maximum": 9999,
      "minimum": 1,
      "type": "integer"
    },
    "Day": {
      "pattern": "^2[0-9]{3}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "DayCells": {
      "additionalProperties": false,
      "description": "The day report's cells: one list per event, left out when empty.",
      "properties": {
        "agent_install": {
          "description": "`agent_install`.",
          "items": {
            "$ref": "#/$defs/Cell_AgentInstall"
          },
          "type": "array"
        },
        "answer_ended": {
          "description": "`answer_ended`.",
          "items": {
            "$ref": "#/$defs/Cell_AnswerEnded"
          },
          "type": "array"
        },
        "app_opened": {
          "description": "`app_opened`.",
          "items": {
            "$ref": "#/$defs/Cell_AppOpened"
          },
          "type": "array"
        },
        "break_shown": {
          "description": "`break_shown`.",
          "items": {
            "$ref": "#/$defs/Cell_BreakShown"
          },
          "type": "array"
        },
        "error_shown": {
          "description": "`error_shown`.",
          "items": {
            "$ref": "#/$defs/Cell_ErrorShown"
          },
          "type": "array"
        },
        "feature_used": {
          "description": "`feature_used`.",
          "items": {
            "$ref": "#/$defs/Cell_FeatureUsed"
          },
          "type": "array"
        },
        "first_read": {
          "description": "`first_read`.",
          "items": {
            "$ref": "#/$defs/Cell_FirstRead"
          },
          "type": "array"
        },
        "limit": {
          "description": "`limit`.",
          "items": {
            "$ref": "#/$defs/Cell_Limit"
          },
          "type": "array"
        },
        "matter_opened": {
          "description": "`matter_opened`.",
          "items": {
            "$ref": "#/$defs/Cell_MatterOpened"
          },
          "type": "array"
        },
        "onboarding_step": {
          "description": "`onboarding_step`.",
          "items": {
            "$ref": "#/$defs/Cell_Onboarding"
          },
          "type": "array"
        },
        "permission_asked": {
          "description": "`permission_asked`.",
          "items": {
            "$ref": "#/$defs/Cell_PermissionAsked"
          },
          "type": "array"
        },
        "question_sent": {
          "description": "`question_sent`.",
          "items": {
            "$ref": "#/$defs/Cell_QuestionSent"
          },
          "type": "array"
        },
        "setting_changed": {
          "description": "`setting_changed`.",
          "items": {
            "$ref": "#/$defs/Cell_SettingChanged"
          },
          "type": "array"
        },
        "sign_in": {
          "description": "`sign_in`.",
          "items": {
            "$ref": "#/$defs/Cell_SignIn"
          },
          "type": "array"
        },
        "stall": {
          "description": "`stall`.",
          "items": {
            "$ref": "#/$defs/Cell_Stall"
          },
          "type": "array"
        },
        "time_open": {
          "description": "`time_open`.",
          "items": {
            "$ref": "#/$defs/Cell_TimeOpen"
          },
          "type": "array"
        },
        "update": {
          "description": "`update`.",
          "items": {
            "$ref": "#/$defs/Cell_Update"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "DayReport": {
      "additionalProperties": false,
      "description": "One install's counts for one finished UTC day.",
      "properties": {
        "arch": {
          "$ref": "#/$defs/Arch",
          "description": "The CPU architecture."
        },
        "cells": {
          "$ref": "#/$defs/DayCells",
          "description": "The day's non-zero cells."
        },
        "channel": {
          "$ref": "#/$defs/Channel",
          "description": "`stable` or `beta`."
        },
        "day": {
          "$ref": "#/$defs/Day",
          "description": "The UTC day."
        },
        "install": {
          "$ref": "#/$defs/InstallId",
          "description": "The install id."
        },
        "language": {
          "$ref": "#/$defs/Language",
          "description": "The app's language."
        },
        "os": {
          "$ref": "#/$defs/Os",
          "description": "The OS."
        },
        "os_major": {
          "anyOf": [
            {
              "$ref": "#/$defs/OsMajor"
            },
            {
              "type": "null"
            }
          ],
          "description": "The OS's major version; Linux leaves it out."
        },
        "schema": {
          "$ref": "#/$defs/SchemaVersion",
          "description": "`1`."
        },
        "version": {
          "$ref": "#/$defs/Version",
          "description": "The app's version."
        }
      },
      "required": [
        "schema",
        "install",
        "day",
        "version",
        "channel",
        "os",
        "arch",
        "language",
        "cells"
      ],
      "type": "object"
    },
    "Delivery": {
      "description": "`question_sent.delivery`.",
      "oneOf": [
        {
          "const": "now",
          "description": "Sent at once.",
          "type": "string"
        },
        {
          "const": "queued",
          "description": "Queued behind an answer.",
          "type": "string"
        },
        {
          "const": "steer",
          "description": "Sent into a running answer.",
          "type": "string"
        }
      ]
    },
    "Feature": {
      "description": "`feature_used.feature`.",
      "oneOf": [
        {
          "const": "versions",
          "description": "Versions.",
          "type": "string"
        },
        {
          "const": "compare",
          "description": "Compare.",
          "type": "string"
        },
        {
          "const": "restore",
          "description": "Restore.",
          "type": "string"
        },
        {
          "const": "undo",
          "description": "Undo.",
          "type": "string"
        },
        {
          "const": "open_in_word",
          "description": "Open in Word.",
          "type": "string"
        },
        {
          "const": "citation",
          "description": "A citation.",
          "type": "string"
        },
        {
          "const": "source",
          "description": "A source.",
          "type": "string"
        },
        {
          "const": "kanoon_search",
